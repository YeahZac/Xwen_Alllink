PORT=80
NODE_ENV=production

# ---------- 数据库（二选一）----------
# A) 微信云托管常用变量（控制台 MySQL 页可复制）
# MYSQL_ADDRESS=10.x.x.x:3306
# MYSQL_USERNAME=你的用户名
# MYSQL_PASSWORD=你的密码
# MYSQL_DATABASE=wanyehulian

# B) 通用变量（与 A 同时存在时优先 B）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=wanyehulian

# JWT
JWT_SECRET=please_change_to_long_random_string
JWT_EXPIRES_IN=7d

# 安全开关（生产务必保持默认；联调再打开）
# ALLOW_PAY_SIMULATE=1
# ALLOW_INVITE_LOGIN=1
# ALLOW_BODY_OPENID=1

# 运营后台登录码（浏览器打开 /admin/）
ADMIN_CODE=A001

# 对外域名（运营台 / 支付回调）
PUBLIC_BASE_URL=https://wanye.cloud
ADMIN_HOST=wanye.cloud

# 微信小程序（登录 code2session）
WX_APPID=
WX_APP_SECRET=

# ---------- 微信支付服务商 / 电商收付通 ----------
# 服务商商户号 sp_mchid
WX_PAY_MCH_ID=
WX_PAY_API_V3_KEY=
WX_PAY_SERIAL_NO=
# 私钥：本地用路径；云托管可挂载 secrets 或把 PEM 全文写入 WX_PAY_PRIVATE_KEY
WX_PAY_PRIVATE_KEY_PATH=secrets/wxpay/apiclient_key.pem
# WX_PAY_PRIVATE_KEY=
WX_PAY_PUBLIC_KEY_PATH=secrets/wxpay/pub_key.pem
WX_PAY_PUBLIC_KEY_ID=
# 支付结果通知 URL（商户平台 / 合作伙伴平台也要填同一地址）
WX_PAY_NOTIFY_URL=https://wanye.cloud/api/wxpay/notify
# auto | ecommerce | partner | direct
WX_PAY_MODE=auto
# 尚无二级商户时允许平台商户号直收联调
WX_PAY_ALLOW_DIRECT=1
# 平台自营测试用二级商户号（可选）；正式按门店 wx_sub_mch_id
WX_PAY_SUB_MCH_ID=
# 电商收付通订单是否标记分账
WX_PAY_PROFIT_SHARING=1

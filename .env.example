PORT=80
NODE_ENV=production

# ---------- 数据库（二选一）----------
# A) 微信云托管常用变量（控制台 MySQL 页可复制）
# MYSQL_ADDRESS=10.x.x.x:3306
# MYSQL_USERNAME=你的用户名
# MYSQL_PASSWORD=你的密码
# MYSQL_DATABASE=wanyehulian

# B) 通用变量（与 A 同时存在时优先 B）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=wanyehulian

# JWT
JWT_SECRET=please_change_to_long_random_string
JWT_EXPIRES_IN=7d

# 运营后台登录码（浏览器打开 /admin/）
ADMIN_CODE=A001

# 微信小程序（登录 code2session）
WX_APPID=
WX_APP_SECRET=

# 可选：微信支付服务商（收付通）。未配置时组合支付的现金部分按微信支付成功模拟入账
WX_PAY_MCH_ID=
WX_PAY_API_V3_KEY=
WX_PAY_SERIAL_NO=

@import "../books/books.wxss";

.form {
  background: #fff;
  border-radius: 36rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 35, 41, 0.05);
}
.form__input {
  display: block;
  width: 100%;
  min-height: 88rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #ede8e3;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #1f2329;
  line-height: 1.4;
}
.btn-primary {
  margin-top: 24rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  background: #ff4d4f;
  color: #fff;
}

<view class="page page--tabbed">
  <view class="m-page-head">
    <text class="m-page-head__title">商家订单</text>
    <text class="m-page-head__desc">管辖区内推广相关商家近单</text>
  </view>
  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view wx:elif="{{!list.length}}" class="empty">暂无关联订单</view>
  <view class="role-list" wx:else>
    <view class="role-card" wx:for="{{list}}" wx:key="id">
      <view class="role-card__seal">单</view>
      <view class="role-card__main">
        <text class="role-card__title">{{item.shopName || '门店'}} · {{item.orderNo || item.id}}</text>
        <text class="role-card__sub">{{item.statusText || item.status || ''}} · {{item.createdAt || ''}}</text>
      </view>
      <view class="role-card__side">
        <text class="role-card__amt">¥{{item.amount || 0}}</text>
      </view>
    </view>
  </view>
  <role-tabbar role="partner" active="orders" />
</view>

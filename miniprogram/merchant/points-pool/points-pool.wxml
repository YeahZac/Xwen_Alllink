<view class="page">
  <view class="wallet">
    <text class="wallet__label">{{shopName}} · 积分额度池</text>
    <text class="wallet__num">{{balance}}</text>
    <text class="wallet__hint">约对应现金价值 ¥{{cashValue}} · {{cashRateText}}</text>
    <text class="wallet__note">开店默认获赠额度；平台管理员可继续划拨；也可采购补充。</text>
  </view>

  <view class="actions">
    <button class="btn-ghost" bindtap="goPurchase">采购补充额度</button>
  </view>

  <view class="m-page-head">
    <text class="m-page-head__title m-page-head__title--section">额度流水</text>
    <text class="m-page-head__desc">开店赠送 / 后台划拨 / 采购获额 / 分出给顾客</text>
  </view>

  <view wx:if="{{!ledger.length}}" class="empty-state surface">
    <text class="empty-state__title">暂无流水</text>
    <text class="empty-state__desc">开店赠送与后台划拨都会记入本店额度池</text>
  </view>

  <view class="m-list">
    <view wx:for="{{ledger}}" wx:key="id" class="m-row">
      <view class="m-row__seal {{item.up ? 'm-row__seal--red' : ''}}">额</view>
      <view class="m-row__main">
        <text class="m-row__title ellipsis-1">{{item.title}}</text>
        <text class="m-row__sub">{{item.time}}</text>
      </view>
      <text class="chg {{item.up ? 'up' : 'down'}}">{{item.changeText}}</text>
    </view>
  </view>
</view>

.opts .m-page-head {
  margin-bottom: 16rpx;
}

.tpl-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.tpl-row .btn-ghost,
.tpl-row button {
  height: 56rpx !important;
  min-height: 56rpx !important;
  line-height: 1.2 !important;
  padding: 0 20rpx !important;
  font-size: 24rpx !important;
  box-sizing: border-box;
}

.group {
  padding: 24rpx;
  margin-bottom: 20rpx;
  overflow: visible;
}

.group__head {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.group__name {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  line-height: 72rpx;
  background: #f7f4f0;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.group__type {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 20rpx;
  background: rgba(255, 77, 79, 0.08);
  color: #ff4d4f;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  white-space: nowrap;
  box-sizing: border-box;
}

.group__flags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 16rpx 0 8rpx;
}

.flag {
  font-size: 22rpx;
  height: 48rpx;
  line-height: 48rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.05);
  color: #666;
  box-sizing: border-box;
}

.flag--on {
  background: rgba(255, 77, 79, 0.12);
  color: #ff4d4f;
  font-weight: 700;
}

.flag--danger {
  color: #ff4d4f;
}

.opt {
  padding: 16rpx 0;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
}

.opt__name {
  width: 100%;
  height: 68rpx;
  line-height: 68rpx;
  background: #f7f4f0;
  border-radius: 12rpx;
  padding: 0 18rpx;
  font-size: 26rpx;
  margin-bottom: 12rpx;
  box-sizing: border-box;
}

.opt__row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}

.opt__field {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 56rpx;
  background: #f7f4f0;
  border-radius: 12rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
}

.opt__lab {
  font-size: 22rpx;
  color: #888;
  flex-shrink: 0;
}

.opt__num {
  width: 120rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.opt__row .btn-ghost,
.opt__row button,
.group .btn-ghost.sm,
.group button.sm {
  height: 56rpx !important;
  min-height: 56rpx !important;
  line-height: 1.2 !important;
  padding: 0 16rpx !important;
  font-size: 24rpx !important;
}

.add-group {
  margin: 8rpx 0 24rpx;
  height: 64rpx !important;
  min-height: 64rpx !important;
  line-height: 64rpx !important;
  font-size: 28rpx !important;
}

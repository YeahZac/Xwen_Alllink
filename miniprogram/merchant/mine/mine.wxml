<view class="page m-home page--flush page--tabbed">
  <page-nav title="商家·我的" tone="solid" show-home="{{true}}" home-url="/pages/index/index" home-switch-consumer="{{true}}" />
  <view class="m-home-shell">
    <view class="shop-card">
      <text class="shop-card__name">{{shopName}}</text>
      <text class="shop-card__meta">{{userName}} · {{roleName}}</text>
    </view>
    <view class="menu-grid">
      <view class="menu-tile" bindtap="go" data-url="/merchant/customers/customers">
        <text class="menu-tile__title">客户</text>
        <text class="menu-tile__sub">到店与核销客</text>
      </view>
      <view class="menu-tile" bindtap="go" data-url="/merchant/points-pool/points-pool">
        <text class="menu-tile__title">积分池</text>
        <text class="menu-tile__sub">额度与划拨</text>
      </view>
      <view class="menu-tile" bindtap="go" data-url="/merchant/assets/assets">
        <text class="menu-tile__title">资产账户</text>
        <text class="menu-tile__sub">货款与提现</text>
      </view>
      <view class="menu-tile" bindtap="goIdentity">
        <text class="menu-tile__title">切换身份</text>
        <text class="menu-tile__sub">消费者 / 合伙人 / 创始人</text>
      </view>
    </view>
    <view class="action-stack">
      <view class="btn-outline-primary" bindtap="onSwitchConsumer">切回消费者</view>
    </view>
    <view class="btn-gradient logout" bindtap="onLogout">退出登录</view>
  </view>
  <role-tabbar role="merchant" active="mine" />
</view>

.tabs {
  display: flex;
  gap: 8rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
  padding: 8rpx;
  background: #fff;
  border-radius: 36rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 35, 41, 0.05);
}

.tab {
  font-size: 24rpx;
  color: #8f959e;
  padding: 14rpx 24rpx;
  line-height: 1.3;
  border-radius: 999rpx;
  font-weight: 600;
}

.tab--on {
  color: #fff;
  font-weight: 800;
  background: linear-gradient(90deg, #ff7a45 0%, #ff4d4f 100%);
}

<view class="page page--tabbed">
  <view class="m-page-head">
    <text class="m-page-head__title">订单</text>
    <text class="m-page-head__desc">{{desc}}</text>
  </view>

  <view class="tabs" wx:if="{{tabs.length > 1}}">
    <text
      wx:for="{{tabs}}"
      wx:key="*this"
      class="tab {{tab === item ? 'tab--on' : ''}}"
      bindtap="switchTab"
      data-t="{{item}}"
    >{{item}}</text>
  </view>

  <view wx:if="{{loading}}" class="empty-state">
    <text class="empty-state__title">正在加载订单</text>
    <text class="empty-state__desc">请稍候</text>
  </view>

  <view wx:elif="{{!list.length}}" class="empty-state surface">
    <text class="empty-state__title">暂无订单</text>
    <text class="empty-state__desc">切换上方分类或稍后再看</text>
  </view>

  <view class="role-list" wx:else>
    <view
      wx:for="{{list}}"
      wx:key="id"
      class="role-card role-card--stack"
      bindtap="onOpen"
      data-id="{{item.id}}"
    >
      <view class="role-card__seal">单</view>
      <view class="role-card__main">
        <text class="role-card__title">{{item.title}}</text>
        <text class="role-card__sub">{{item.sub}} · {{item.time}}</text>
      </view>
      <view class="role-card__side">
        <text class="chip chip--soft">{{item.statusText}}</text>
        <text class="role-card__amt" wx:if="{{item.amount}}">{{item.amount}}</text>
      </view>
      <view class="role-card__actions" wx:if="{{item.canShip || item.canConfirm || item.canComplete || item.canCancel}}">
        <button
          wx:if="{{item.canShip}}"
          class="btn-primary sm"
          size="mini"
          data-id="{{item.id}}"
          catchtap="onShip"
          loading="{{busyId === item.id}}"
          disabled="{{busyId !== ''}}"
        >发货</button>
        <button
          wx:if="{{item.canConfirm}}"
          class="btn-ghost sm"
          size="mini"
          data-id="{{item.id}}"
          catchtap="onConfirm"
          loading="{{busyId === item.id}}"
          disabled="{{busyId !== ''}}"
        >确认收货</button>
        <button
          wx:if="{{item.canComplete}}"
          class="btn-primary sm"
          size="mini"
          data-id="{{item.id}}"
          catchtap="onComplete"
          loading="{{busyId === item.id}}"
          disabled="{{busyId !== ''}}"
        >完成出餐</button>
        <button
          wx:if="{{item.canCancel}}"
          class="btn-ghost sm"
          size="mini"
          data-id="{{item.id}}"
          catchtap="onCancel"
          loading="{{busyId === item.id}}"
          disabled="{{busyId !== ''}}"
        >取消</button>
      </view>
    </view>
  </view>
  <role-tabbar role="merchant" active="orders" />
</view>

/* 商家 / 合伙人 / 创始人 首页壳：细节由全局 role-kit 接管 */
.m-home.page--flush {
  padding: 0;
  background: var(--color-bg, #f7f4f0);
}

/* 底栏安全区由全局 role-kit .page--tabbed 统一控制 */

.m-home-shell {
  padding: 20rpx 24rpx 20rpx;
}

.status-strip {
  margin-bottom: 12rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  line-height: 1.45;
  background: #fff;
  color: #1f2329;
  box-shadow: 0 6rpx 20rpx rgba(31, 35, 41, 0.05);
  word-break: break-word;
}

.status-strip--warn {
  background: #fff7e8;
  color: #d46b08;
}

.kpi {
  display: flex;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #ede8e3;
}

.kpi__cell {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 4rpx 4rpx;
  border-right: 1rpx solid #ede8e3;
}

.kpi__cell:last-child {
  border-right: none;
}

.kpi__v {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #ff4d4f;
  line-height: 1.25;
  font-variant-numeric: tabular-nums;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.kpi__l {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 0.04em;
  color: #8f959e;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.logout {
  margin-top: 24rpx;
  margin-bottom: 16rpx;
}

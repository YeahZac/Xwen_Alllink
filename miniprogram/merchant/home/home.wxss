.m-home.page--flush {
  padding: 0;
  padding-bottom: calc(var(--space-lg) + env(safe-area-inset-bottom));
  background: var(--color-bg);
}

.hero {
  position: relative;
  height: 360rpx;
  overflow: hidden;
  background: var(--color-ink);
}

.hero__cover {
  width: 100%;
  height: 100%;
  display: block;
}

.hero__cover--fallback {
  background: linear-gradient(145deg, #1a1d24 0%, #3a1018 100%);
}

.hero__mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(18, 20, 26, 0.2) 0%, rgba(18, 20, 26, 0.88) 100%);
}

.hero__body {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: var(--space-md) var(--space-page) 64rpx;
  z-index: 1;
}

.hero__role {
  display: inline-flex;
  padding: var(--space-2) var(--space-sm);
  background: var(--color-primary);
  color: #fff;
  font-size: var(--font-tiny);
  font-weight: 800;
  letter-spacing: var(--tracking-label);
  border-radius: var(--radius-xs);
  margin-bottom: var(--space-sm);
}

.hero__shop {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-all;
  font-size: var(--font-display);
  font-weight: 800;
  color: #fff;
  letter-spacing: var(--tracking-display);
  line-height: var(--lh-tight);
}

.hero__meta {
  display: block;
  margin-top: var(--space-xs);
  font-size: var(--font-caption);
  color: rgba(255, 255, 255, 0.72);
}

.panel {
  margin-top: -28rpx;
  position: relative;
  z-index: 2;
  padding: 36rpx var(--space-page) 0;
}

.status-strip {
  margin-bottom: var(--space-sm);
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-md);
  font-size: var(--font-caption);
  line-height: var(--lh-snug);
  background: var(--color-surface);
  color: var(--color-ink);
}

.status-strip--warn {
  background: var(--color-accent-soft);
  color: var(--color-accent-deep);
}

.kpi {
  display: flex;
  gap: var(--space-sm);
  padding: var(--space-md);
  margin-bottom: var(--space-md);
  background: var(--color-surface);
  border-radius: var(--radius-lg);
}

.kpi__cell {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: var(--space-xs) var(--space-2);
  border-right: 1rpx solid var(--color-border);
}

.kpi__cell:last-child {
  border-right: none;
}

.kpi__v {
  display: block;
  font-size: var(--font-subtitle);
  font-weight: 800;
  color: var(--color-ink);
  line-height: 1.25;
  font-variant-numeric: tabular-nums;
}

.kpi__l {
  display: block;
  margin-top: var(--space-xs);
  font-size: var(--font-tiny);
  font-weight: 700;
  letter-spacing: var(--tracking-label);
  color: var(--color-text-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.block {
  margin-top: var(--space-md);
  margin-bottom: var(--space-md);
}

.block__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: var(--space-sm);
}

.block__title {
  font-size: var(--font-title);
  font-weight: 800;
  color: var(--color-ink);
  letter-spacing: 0.02em;
}

.block__sub {
  font-size: var(--font-tiny);
  font-weight: 700;
  letter-spacing: var(--tracking-label);
  color: var(--color-text-muted);
}

.tools {
  margin-bottom: var(--space-lg);
}

.logout {
  text-align: center;
  padding: var(--space-lg);
  font-size: var(--font-caption);
  font-weight: 700;
  letter-spacing: var(--tracking-label);
  color: var(--color-text-muted);
}

.logout:active {
  color: var(--color-primary);
}

<!-- 商户工作台 · 经营驾驶舱 -->
<view class="page m-home page--flush">
  <view class="hero">
    <image wx:if="{{coverUrl}}" class="hero__cover" src="{{coverUrl}}" mode="aspectFill" />
    <view wx:else class="hero__cover hero__cover--fallback"></view>
    <view class="hero__mask"></view>
    <view class="hero__body">
      <view class="hero__role">{{roleName}}</view>
      <text class="hero__shop">{{shopName}}</text>
      <text class="hero__meta ellipsis-1">{{heroMeta}}</text>
    </view>
  </view>

  <view class="panel">
    <view wx:if="{{loadError}}" class="status-strip status-strip--warn">
      <text>{{loadError}}，功能入口仍可使用</text>
    </view>
    <view wx:if="{{feeHint}}" class="status-strip">
      <text>{{feeHint}}</text>
    </view>
    <view class="status-strip {{shopOpen ? '' : 'status-strip--warn'}}" bindtap="onToggleOpen">
      <text>{{shopOpen ? '营业中 · 点此歇业' : '歇业中 · 点此开业'}}</text>
    </view>

    <view class="kpi">
      <view class="kpi__cell">
        <text class="kpi__v ellipsis-1">{{kpi.a}}</text>
        <text class="kpi__l">{{kpi.aLabel}}</text>
      </view>
      <view class="kpi__cell">
        <text class="kpi__v ellipsis-1">{{kpi.b}}</text>
        <text class="kpi__l">{{kpi.bLabel}}</text>
      </view>
      <view class="kpi__cell">
        <text class="kpi__v ellipsis-1">{{kpi.c}}</text>
        <text class="kpi__l">{{kpi.cLabel}}</text>
      </view>
    </view>

    <view class="block">
      <view class="block__head ink-rail">
        <text class="block__title">经营功能</text>
        <text class="block__sub">点选进入</text>
      </view>

      <view class="m-list">
        <view
          wx:for="{{menus}}"
          wx:key="id"
          class="m-row"
          bindtap="go"
          data-url="{{item.url}}"
        >
          <view class="m-row__seal {{item.sealClass}}">{{item.icon}}</view>
          <view class="m-row__main">
            <text class="m-row__title ellipsis-1">{{item.title}}</text>
            <text class="m-row__sub ellipsis-1">{{item.sub}}</text>
          </view>
          <text class="m-row__arrow">›</text>
        </view>
      </view>
    </view>

    <view class="m-list tools">
      <view class="m-row" wx:if="{{role !== 'supply'}}" bindtap="goAssets">
        <view class="m-row__seal m-row__seal--gold">资</view>
        <view class="m-row__main">
          <text class="m-row__title">资产账户</text>
          <text class="m-row__sub ellipsis-1">{{assetsHint}}</text>
        </view>
        <text class="m-row__arrow">›</text>
      </view>
      <view class="m-row" wx:if="{{role === 'stall'}}" bindtap="onQr">
        <view class="m-row__seal">码</view>
        <view class="m-row__main">
          <text class="m-row__title">摊位收款码</text>
          <text class="m-row__sub">顾客扫码后输入金额付款</text>
        </view>
        <text class="m-row__arrow">›</text>
      </view>
    </view>

    <ad-banner role="{{role}}" height="280" />

    <view class="m-list m-list--legal">
      <view class="m-row" bindtap="openLegalDoc" data-key="user">
        <view class="m-row__main">
          <text class="m-row__title">用户服务协议</text>
        </view>
        <text class="m-row__arrow">›</text>
      </view>
      <view class="m-row" bindtap="openLegalDoc" data-key="merchant">
        <view class="m-row__main">
          <text class="m-row__title">商户入驻平台协议</text>
        </view>
        <text class="m-row__arrow">›</text>
      </view>
      <view class="m-row" bindtap="openLegalDoc" data-key="dispute">
        <view class="m-row__main">
          <text class="m-row__title">消费者权益保障措施说明</text>
        </view>
        <text class="m-row__arrow">›</text>
      </view>
    </view>

    <view class="logout" bindtap="onLogout">退出登录</view>
  </view>
</view>

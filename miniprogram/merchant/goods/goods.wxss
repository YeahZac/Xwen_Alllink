.add-btn {
  width: auto;
  margin: 0 0 20rpx;
  height: 72rpx;
  min-height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
}

.goods-title {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.goods-title .role-card__title {
  flex: 1;
  min-width: 0;
}

.goods-title .chip {
  flex-shrink: 0;
  margin-top: 4rpx;
}

.role-card--stack {
  overflow: visible;
  padding-bottom: 24rpx;
}

.role-card__actions {
  padding-left: 0;
}

<view class="page page--tabbed">
  <view class="m-page-head">
    <text class="m-page-head__title">{{title || '物料'}}</text>
    <text class="m-page-head__desc">菜品/商品上架、调价与规格</text>
  </view>

  <button class="btn-primary add-btn" bindtap="onAdd">添加商品</button>

  <view wx:if="{{loading}}" class="empty-state">
    <text class="empty-state__title">正在加载商品</text>
    <text class="empty-state__desc">请稍候</text>
  </view>

  <view wx:elif="{{!list.length}}" class="empty-state surface">
    <text class="empty-state__title">暂无商品</text>
    <text class="empty-state__desc">点上方「添加商品」完善信息后上架</text>
  </view>

  <view class="role-list" wx:else>
    <view wx:for="{{list}}" wx:key="id" class="role-card role-card--stack">
      <view class="role-card__seal">{{item.name[0] || '品'}}</view>
      <view class="role-card__main">
        <view class="goods-title">
          <text class="role-card__title">{{item.name}}</text>
          <text class="chip {{role === 'supply' || item.status === '在售' || item.status === '上架' ? 'chip--soft' : 'chip--off'}}">{{item.status}}</text>
        </view>
        <text class="role-card__sub">{{item.line}}</text>
      </view>
      <view class="role-card__actions">
        <button class="btn-ghost sm" size="mini" data-id="{{item.id}}" bindtap="onFullEdit">编辑</button>
        <button class="btn-ghost sm" size="mini" data-id="{{item.id}}" bindtap="onPrice">改价格</button>
        <button class="btn-ghost sm" size="mini" wx:if="{{role === 'cross'}}" data-id="{{item.id}}" bindtap="onPoints">改积分</button>
        <button class="btn-ghost sm" size="mini" wx:if="{{role === 'stall'}}" data-id="{{item.id}}" bindtap="onOptions">规格</button>
        <button class="btn-ghost sm" size="mini" data-id="{{item.id}}" bindtap="onEdit">
          {{item.onSale ? '下架' : '上架'}}
        </button>
      </view>
    </view>
  </view>
  <role-tabbar role="merchant" active="goods" />
</view>

.amt {
  font-size: var(--font-subtitle);
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
  white-space: nowrap;
}

.amt--up {
  color: var(--color-primary);
}

.amt--down {
  color: var(--color-ink);
}

.page--tabbed {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}


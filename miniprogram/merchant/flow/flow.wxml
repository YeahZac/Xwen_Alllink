<view class="page">
  <view class="m-page-head">
    <text class="m-page-head__title">交易流水</text>
    <text class="m-page-head__desc">收款、采购、核销与结算</text>
  </view>

  <view wx:if="{{loading}}" class="empty-state">
    <text class="empty-state__title">正在加载流水</text>
    <text class="empty-state__desc">请稍候</text>
  </view>

  <view wx:elif="{{!list.length}}" class="empty-state surface">
    <text class="empty-state__title">暂无交易流水</text>
    <text class="empty-state__desc">产生收款、采购或核销后会显示在这里</text>
  </view>

  <view class="m-list">
    <view wx:for="{{list}}" wx:key="id" class="m-row">
      <view class="m-row__seal">流</view>
      <view class="m-row__main">
        <text class="m-row__title ellipsis-1">{{item.title}}</text>
        <text class="m-row__sub ellipsis-1">{{item.sub}}</text>
      </view>
      <view class="m-row__side">
        <text class="amt {{item.up ? 'amt--up' : 'amt--down'}}">{{item.amount}}</text>
      </view>
    </view>
  </view>
</view>

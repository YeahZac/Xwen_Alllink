<view class="page page--tabbed">
  <view class="m-page-head">
    <text class="m-page-head__title">财务</text>
    <text class="m-page-head__desc">收款、采购、核销与结算流水</text>
  </view>

  <view wx:if="{{loading}}" class="empty-state">
    <text class="empty-state__title">正在加载流水</text>
    <text class="empty-state__desc">请稍候</text>
  </view>

  <view wx:elif="{{!list.length}}" class="empty-state surface">
    <text class="empty-state__title">暂无交易流水</text>
    <text class="empty-state__desc">产生收款、采购或核销后会显示在这里</text>
  </view>

  <view class="role-list" wx:else>
    <view wx:for="{{list}}" wx:key="id" class="role-card">
      <view class="role-card__seal">流</view>
      <view class="role-card__main">
        <text class="role-card__title">{{item.title}}</text>
        <text class="role-card__sub">{{item.sub}}</text>
      </view>
      <view class="role-card__side">
        <text class="role-card__amt {{item.up ? 'amt--up' : 'amt--down'}}">{{item.amount}}</text>
      </view>
    </view>
  </view>
  <role-tabbar role="merchant" active="finance" />
</view>

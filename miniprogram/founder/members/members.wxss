.page--tabbed { padding: 24rpx 24rpx calc(140rpx + env(safe-area-inset-bottom)); }
.filters { margin-bottom: 16rpx; }
.search {
  background: #fff;
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
}
.chips { display: flex; gap: 12rpx; margin-top: 16rpx; }
.chip {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #8f959e;
  font-size: 24rpx;
}
.chip--on { background: #ff4d4f; color: #fff; font-weight: 700; }
.row {
  display: flex;
  padding: 24rpx;
  margin-bottom: 12rpx;
  background: #fff;
  border-radius: 16rpx;
}
.row__t { display: block; font-weight: 700; }
.row__s { display: block; margin-top: 6rpx; font-size: 22rpx; color: #8f959e; }
.row__tags { display: block; margin-top: 8rpx; font-size: 22rpx; color: #ff4d4f; }
.empty { padding: 80rpx 0; text-align: center; color: #8f959e; }

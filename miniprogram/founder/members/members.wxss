.filters {
  margin-bottom: 20rpx;
}
.search {
  background: #fff;
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  box-shadow: 0 6rpx 20rpx rgba(31, 35, 41, 0.05);
}
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}
.chip {
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #8f959e;
  font-size: 24rpx;
  line-height: 1.3;
}
.chip--on {
  background: #ff4d4f;
  color: #fff;
  font-weight: 700;
}
.role-card__tags {
  color: #ff4d4f !important;
}
.empty {
  padding: 96rpx 24rpx;
  text-align: center;
  color: #8f959e;
  font-size: 28rpx;
}

<view class="page page--tabbed">
  <view class="filters">
    <input class="search" placeholder="昵称/手机/邀请码" value="{{q}}" bindinput="onQ" confirm-type="search" bindconfirm="onSearch" />
    <view class="chips">
      <text class="chip {{role===''?'chip--on':''}}" data-role="" bindtap="onRole">全部</text>
      <text class="chip {{role==='partner'?'chip--on':''}}" data-role="partner" bindtap="onRole">合伙人</text>
      <text class="chip {{role==='founder'?'chip--on':''}}" data-role="founder" bindtap="onRole">创始人</text>
    </view>
  </view>
  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view wx:elif="{{!list.length}}" class="empty">暂无数据</view>
  <view class="row" wx:for="{{list}}" wx:key="id">
    <view class="row__main">
      <text class="row__t">{{item.nickname || '用户'}} · #{{item.id}}</text>
      <text class="row__s">{{item.phone || '无手机'}} · 码 {{item.inviteCode || '—'}} · 积分 {{item.points}}</text>
      <text class="row__tags">{{item.tags}}</text>
    </view>
  </view>
  <role-tabbar role="founder" active="members" />
</view>

.founder-applies {
  padding: 20rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
}

.tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.tab {
  flex: 1;
  min-height: 72rpx;
  text-align: center;
  padding: 18rpx 8rpx;
  font-size: 26rpx;
  line-height: 1.3;
  color: #8f959e;
  background: #fff;
  border-radius: 20rpx;
  box-sizing: border-box;
}

.tab--on {
  color: #fff;
  background: #ff4d4f;
  font-weight: 700;
}

.empty {
  padding: 96rpx 0;
  text-align: center;
  color: #8f959e;
  font-size: 28rpx;
}

.card__actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 24rpx;
}

.sm {
  margin: 0;
  min-width: 140rpx;
  min-height: 64rpx;
}

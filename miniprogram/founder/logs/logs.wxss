.page--tabbed { padding: 24rpx 24rpx calc(140rpx + env(safe-area-inset-bottom)); }
.m-page-head__title { display:block; font-size:36rpx; font-weight:800; }
.m-page-head__desc { display:block; margin-top:8rpx; color:#8f959e; font-size:24rpx; margin-bottom:16rpx; }
.row {
  padding: 24rpx;
  margin-bottom: 12rpx;
  background: #fff;
  border-radius: 16rpx;
}
.row__t { display:block; font-weight:700; word-break: break-all; }
.row__s { display:block; margin-top:6rpx; font-size:22rpx; color:#8f959e; }
.row__d { display:block; margin-top:8rpx; font-size:22rpx; color:#555; }
.empty { padding: 80rpx 0; text-align: center; color: #8f959e; }

.kpi-row {
  display: flex;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 36rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 35, 41, 0.05);
  overflow: hidden;
}

.kpi {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 28rpx 8rpx;
}

.kpi__v {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #ff4d4f;
  line-height: 1.25;
}

.kpi__l {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8f959e;
  line-height: 1.3;
}

.card {
  min-height: 176rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 36rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 35, 41, 0.05);
  box-sizing: border-box;
}

.card__t {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #1f2329;
  line-height: 1.35;
  word-break: break-word;
}

.card__s {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8f959e;
  line-height: 1.45;
  word-break: break-word;
}

.form {
  margin-top: 8rpx;
  padding: 28rpx;
  background: #fff;
  border-radius: 36rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 35, 41, 0.05);
}

.form input {
  display: block;
  width: 100%;
  min-height: 88rpx;
  background: #f7f4f0;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.btn-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}

.sm {
  margin: 0;
  min-height: 64rpx;
  min-width: 140rpx;
  font-size: 24rpx;
}

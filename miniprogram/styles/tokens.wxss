/* 万业互联云 · cross-final / ok-* 统一视觉
   暖米底 · 红橙渐变头图 · 大圆角白卡 · 双列店卡 */

page {
  /* —— Color —— */
  --color-bg: #F7F4F0;
  --color-surface: #FFFFFF;
  --color-surface-soft: #F3F0EC;
  --color-ink: #1F2329;
  --color-text: #1F2329;
  --color-text-secondary: #646A73;
  --color-text-muted: #8F959E;
  --color-border: #EDE8E3;
  --color-border-strong: #E0DAD3;

  --color-primary: #FF4D4F;
  --color-primary-soft: #FFF1F0;
  --color-primary-deep: #E03436;
  --color-primary-mid: #FF7875;

  --color-accent: #FF7A45;
  --color-accent-soft: #FFF7E8;
  --color-accent-deep: #D46B08;

  --color-header-start: #FF8A5C;
  --color-header-end: #FF4D4F;
  --gradient-header: linear-gradient(135deg, #FF8A5C 0%, #FF4D4F 55%, #E03436 100%);
  --gradient-hero: linear-gradient(120deg, #FF9A5C 0%, #FF5A4A 50%, #FF3D4A 100%);
  --gradient-cta: linear-gradient(90deg, #FF7A45 0%, #FF4D4F 100%);

  --color-success: #00A870;
  --color-success-soft: #E8F8F2;
  --color-danger: #FF4D4F;
  --color-warning: #FAAD14;

  /* —— Radius —— */
  --radius-xs: 8rpx;
  --radius-sm: 14rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --radius-xl: 36rpx;
  --radius-pill: 999rpx;

  /* —— Shadow —— */
  --shadow-soft: 0 6rpx 20rpx rgba(31, 35, 41, 0.05);
  --shadow-card: 0 10rpx 28rpx rgba(31, 35, 41, 0.07);
  --shadow-seal: 0 8rpx 20rpx rgba(255, 77, 79, 0.24);

  /* —— Type（微信小程序可读性：正文≥28rpx，辅助≥24rpx，忌 <22rpx） —— */
  --font-display: 44rpx;
  --font-metric: 52rpx;
  --font-metric-lg: 60rpx;
  --font-title: 34rpx;
  --font-lead: 32rpx;
  --font-subtitle: 30rpx;
  --font-body: 28rpx;
  --font-caption: 26rpx;
  --font-small: 24rpx;
  --font-tiny: 22rpx;
  --font-seal: 24rpx;

  --lh-tight: 1.2;
  --lh-snug: 1.35;
  --lh-body: 1.5;

  --tracking-display: 0.02em;
  --tracking-label: 0.06em;

  /* —— Space —— */
  --space-page: 24rpx;
  --space-2: 4rpx;
  --space-xs: 8rpx;
  --space-sm: 12rpx;
  --space-md: 20rpx;
  --space-lg: 32rpx;
  --space-xl: 48rpx;
  --space-section: 28rpx;

  --size-seal-brand: 40rpx;
  --size-seal-dock: 64rpx;
  --size-seal-row: 56rpx;

  --ease-out: cubic-bezier(0.2, 0.8, 0.2, 1);
  --ease-press: cubic-bezier(0.4, 0, 0.2, 1);
  --dur-fast: 140ms;
  --dur-mid: 200ms;

  background: var(--color-bg);
  color: var(--color-text);
  font-size: var(--font-body);
  line-height: var(--lh-body);
  font-family: "PingFang SC", "Hiragino Sans GB", "Noto Sans SC", "Microsoft YaHei", sans-serif;
  box-sizing: border-box;
  min-height: 100%;
  letter-spacing: 0.01em;
}

view,
text,
image,
button,
input,
scroll-view,
textarea,
picker {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: var(--space-md) var(--space-page) calc(var(--space-lg) + env(safe-area-inset-bottom));
  background: var(--color-bg);
}

.page--flush {
  padding: 0;
  padding-bottom: calc(var(--space-md) + env(safe-area-inset-bottom));
}

/* 红橙渐变页头（分类/积分钱包等） */
.hero-band {
  padding: var(--space-lg) var(--space-page) var(--space-xl);
  background: var(--gradient-header);
  color: #fff;
  position: relative;
  overflow: hidden;
}

.hero-band__title {
  display: block;
  font-size: var(--font-display);
  font-weight: 800;
  line-height: var(--lh-tight);
  letter-spacing: var(--tracking-display);
  position: relative;
  z-index: 1;
}

.hero-band__sub {
  display: block;
  margin-top: var(--space-sm);
  font-size: var(--font-caption);
  color: rgba(255, 255, 255, 0.88);
  line-height: var(--lh-snug);
  position: relative;
  z-index: 1;
}

.hero-card {
  margin: 0 var(--space-page);
  padding: var(--space-lg);
  border-radius: var(--radius-xl);
  background: var(--gradient-hero);
  color: #fff;
  box-shadow: var(--shadow-seal);
}

.hero-card__label {
  display: block;
  font-size: var(--font-caption);
  opacity: 0.92;
}

.hero-card__num {
  display: block;
  margin-top: var(--space-xs);
  font-size: 72rpx;
  font-weight: 800;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.hero-card__hint {
  display: block;
  margin-top: var(--space-sm);
  font-size: var(--font-small);
  opacity: 0.9;
  line-height: var(--lh-snug);
}

.btn-ghost-on-hero {
  margin-top: var(--space-md);
  height: 72rpx;
  line-height: 70rpx;
  text-align: center;
  border-radius: var(--radius-pill);
  border: 2rpx solid rgba(255, 255, 255, 0.85);
  color: #fff;
  font-size: var(--font-body);
  font-weight: 700;
  background: transparent;
}

.btn-ghost-on-hero::after {
  border: none;
}

.btn-outline-primary {
  height: 88rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: var(--radius-pill);
  border: 2rpx solid var(--color-primary);
  color: var(--color-primary);
  font-size: var(--font-body);
  font-weight: 700;
  background: #fff;
}

.btn-outline-primary::after {
  border: none;
}

.btn-gradient {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: var(--radius-pill);
  color: #fff;
  font-size: var(--font-body);
  font-weight: 800;
  background: var(--gradient-cta);
  box-shadow: var(--shadow-seal);
}

.btn-gradient::after {
  border: none;
}

/* 双列门店网格 */
.store-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
}

.store-tile {
  width: calc(50% - 6rpx);
  overflow: hidden;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-soft);
}

.store-tile:active {
  transform: scale(0.985);
}

.store-tile__cover {
  position: relative;
  width: 100%;
  height: 220rpx;
  overflow: hidden;
  background: var(--color-surface-soft);
}

.store-tile__badge {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 2;
  padding: 6rpx 14rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: var(--font-tiny);
  font-weight: 800;
  border-radius: 0 0 var(--radius-sm) 0;
}

.store-tile__body {
  padding: var(--space-sm) var(--space-sm) var(--space-md);
}

.store-tile__name {
  display: block;
  font-size: var(--font-body);
  font-weight: 800;
  color: var(--color-ink);
  line-height: var(--lh-snug);
}

.store-tile__meta,
.store-tile__addr {
  display: block;
  margin-top: 6rpx;
  font-size: var(--font-tiny);
  color: var(--color-text-muted);
  line-height: var(--lh-snug);
}

/* 商户功能宫格 */
.menu-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
}

.menu-tile {
  width: calc(50% - 6rpx);
  padding: var(--space-md);
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-soft);
  min-height: 148rpx;
}

.menu-tile:active {
  transform: scale(0.985);
}

.menu-tile__title {
  display: block;
  font-size: var(--font-subtitle);
  font-weight: 800;
  color: var(--color-ink);
  line-height: var(--lh-snug);
}

.menu-tile__sub {
  display: block;
  margin-top: var(--space-xs);
  font-size: var(--font-tiny);
  color: var(--color-text-muted);
  line-height: var(--lh-snug);
}

.brand-mark {
  display: inline-flex;
  align-items: center;
  gap: var(--space-sm);
}

.brand-mark__dot,
.brand-mark__seal {
  width: var(--size-seal-brand);
  height: var(--size-seal-brand);
  border-radius: var(--radius-sm);
  background: var(--color-primary);
  color: #fff;
  font-size: var(--font-small);
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.brand-mark__name {
  font-size: var(--font-title);
  font-weight: 700;
  letter-spacing: var(--tracking-display);
  color: var(--color-text);
  line-height: var(--lh-tight);
}

.brand-mark--light .brand-mark__name {
  color: #fff;
}

.brand-mark--light .brand-mark__dot,
.brand-mark--light .brand-mark__seal {
  background: #fff;
  color: var(--color-primary);
}

.section-title {
  font-size: var(--font-title);
  font-weight: 800;
  color: var(--color-ink);
  margin: var(--space-section) 0 var(--space-sm);
  line-height: var(--lh-snug);
}

.section-title--first {
  margin-top: var(--space-md);
}

.section-desc {
  display: block;
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
  line-height: var(--lh-body);
  margin-bottom: var(--space-md);
}

.surface {
  background: var(--color-surface);
  border-radius: var(--radius-xl);
  border: none;
  box-shadow: var(--shadow-soft);
}

.surface--lift {
  box-shadow: var(--shadow-card);
}

.ink-rail {
  position: relative;
  padding-left: var(--space-md);
}

.ink-rail::before {
  content: "";
  position: absolute;
  left: 0;
  top: var(--space-xs);
  bottom: var(--space-xs);
  width: 6rpx;
  border-radius: 3rpx;
  background: var(--color-primary);
  pointer-events: none;
}

.chip {
  display: inline-flex;
  align-items: center;
  padding: var(--space-2) var(--space-sm);
  border-radius: var(--radius-xs);
  background: var(--color-primary);
  color: #fff;
  font-size: var(--font-tiny);
  font-weight: 600;
  line-height: var(--lh-snug);
  max-width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.chip--soft {
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
}

.chip--accent {
  background: var(--color-accent-soft);
  color: var(--color-accent-deep);
}

.chip--off {
  background: var(--color-surface-soft);
  color: var(--color-text-muted);
}

.btn-primary {
  background: var(--gradient-cta);
  color: #fff;
  border-radius: var(--radius-pill);
  font-size: var(--font-subtitle);
  font-weight: 700;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border: none;
  box-shadow: var(--shadow-seal);
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  opacity: 0.94;
}

.btn-ghost {
  background: transparent;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
  border-radius: var(--radius-pill);
  font-size: var(--font-body);
  font-weight: 600;
  height: 80rpx;
  line-height: 76rpx;
  text-align: center;
}

.btn-ghost::after {
  border: none;
}

.btn-ghost:active {
  background: var(--color-primary-soft);
}

.btn-on-primary {
  background: #fff;
  color: var(--color-primary-deep);
  border-radius: var(--radius-pill);
  font-size: var(--font-subtitle);
  font-weight: 700;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border: none;
}

.btn-on-primary::after {
  border: none;
}

.btn-on-ink {
  background: #fff;
  color: var(--color-ink);
  border-radius: var(--radius-pill);
  font-size: var(--font-subtitle);
  font-weight: 700;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border: none;
}

.btn-on-ink::after {
  border: none;
}

.price {
  color: var(--color-primary);
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
  white-space: nowrap;
}

.price__yen {
  font-size: var(--font-small);
  margin-right: 2rpx;
}

.muted {
  color: var(--color-text-muted);
  font-size: var(--font-caption);
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.safe-bottom {
  padding-bottom: calc(var(--space-md) + env(safe-area-inset-bottom));
}

.mall-header {
  background: var(--color-surface);
  padding: var(--space-md) var(--space-page) var(--space-lg);
  margin: calc(-1 * var(--space-page)) calc(-1 * var(--space-page)) 0;
  border-radius: 0;
  position: relative;
  overflow: hidden;
  border-bottom: 1rpx solid var(--color-border);
}

.mall-header::after {
  display: none;
}

.mall-header__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-md);
  position: relative;
  z-index: 1;
}

.mall-header__brand {
  font-size: var(--font-title);
  font-weight: 700;
  color: var(--color-ink);
  letter-spacing: var(--tracking-display);
}

.mall-header__actions {
  display: flex;
  gap: var(--space-xs);
}

.pill {
  padding: var(--space-2) var(--space-sm);
  border-radius: var(--radius-pill);
  background: var(--color-surface-soft);
  color: var(--color-text-secondary);
  font-size: var(--font-tiny);
  font-weight: 600;
  border: none;
}

.pill--gold {
  background: var(--color-accent-soft);
  color: var(--color-accent-deep);
  font-weight: 700;
}

.search-bar {
  display: flex;
  align-items: center;
  background: var(--color-surface-soft);
  border-radius: var(--radius-pill);
  padding: 6rpx 8rpx 6rpx 24rpx;
  min-height: 72rpx;
}

.search-bar__input {
  flex: 1;
  height: 64rpx;
  font-size: var(--font-caption);
  color: var(--color-text);
}

.search-bar__btn {
  padding: 0 28rpx;
  height: 64rpx;
  line-height: 64rpx;
  background: var(--color-primary);
  color: #fff;
  border-radius: var(--radius-pill);
  font-size: var(--font-caption);
  font-weight: 600;
}

.mall-body {
  padding: 0 var(--space-page) var(--space-md);
  margin-top: var(--space-sm);
}

.mall-header--flush {
  margin: 0;
  border-radius: 0;
}

.label-caps {
  font-size: var(--font-tiny);
  font-weight: 600;
  letter-spacing: var(--tracking-label);
  color: var(--color-text-muted);
}

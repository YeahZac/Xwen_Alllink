/**
 * 万业互联云 · 多身份 UI 规范（对齐 C 端）
 * ------------------------------------------------
 * 适用范围：商家 / 合伙人 / 创始人 / 负责人工作台与列表
 * 基准：C 端「我的」m-row、「首页」店卡 store/shop-card
 *
 * 字号
 *   导航标题 34rpx · 卡片主标题 30rpx · 正文 28rpx
 *   辅助说明 24rpx · 底栏文字 22rpx（不低于此）
 * 列表行
 *   左右边距 24rpx · 行内 padding 28rpx · 最小高度 184rpx
 *   主副文案最多 2 行，禁止无行硬裁切关键信息
 * 宫格入口
 *   双列 · 最小高度 200rpx · 标题 30rpx · 说明 24rpx 两行
 * 底栏
 *   高 112rpx + safe-area · 图标 48rpx · 文案 22rpx
 * 品牌色
 *   主色 #FF4D4F · 底 #F7F4F0 · 卡片白 · 圆角 36rpx
 */

page {
  --role-page-pad-x: 24rpx;
  --role-page-pad-y: 20rpx;
  --role-card-pad: 28rpx;
  --role-card-min-h: 184rpx;
  --role-card-radius: 36rpx;
  --role-card-gap: 16rpx;
  --role-seal-size: 72rpx;
  --role-cover-size: 176rpx;
  --role-title-size: 30rpx;
  --role-body-size: 28rpx;
  --role-sub-size: 24rpx;
  --role-tab-h: 112rpx;
  --role-tab-icon: 48rpx;
  --role-tab-font: 22rpx;
  --role-menu-min-h: 200rpx;
}

/* —— 带自定义底栏的页面安全区 —— */
.page--tabbed {
  min-height: 100vh;
  padding-left: var(--role-page-pad-x) !important;
  padding-right: var(--role-page-pad-x) !important;
  padding-top: var(--role-page-pad-y) !important;
  padding-bottom: calc(var(--role-tab-h) + 28rpx + env(safe-area-inset-bottom)) !important;
  box-sizing: border-box !important;
  background: var(--color-bg, #f7f4f0) !important;
}

.page--tabbed.page--flush,
.m-home.page--tabbed {
  padding-left: 0 !important;
  padding-right: 0 !important;
  padding-top: 0 !important;
}

.m-home-shell {
  padding: var(--role-page-pad-y) var(--role-page-pad-x) var(--role-page-pad-y);
  box-sizing: border-box;
}

/* —— 身份首页英雄卡（对齐 C 端白卡气场） —— */
.m-home .shop-card,
.role-hero {
  min-height: 220rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: var(--role-card-radius);
  box-shadow: 0 10rpx 28rpx rgba(31, 35, 41, 0.07);
  box-sizing: border-box;
}

.m-home .shop-card__name,
.role-hero__name {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #ff4d4f;
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.m-home .shop-card__meta,
.m-home .shop-card__tags,
.role-hero__meta {
  display: block;
  margin-top: 10rpx;
  font-size: var(--role-sub-size);
  color: #8f959e;
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.m-home .kpi__v {
  font-size: 40rpx !important;
  line-height: 1.25 !important;
}

.m-home .kpi__l {
  font-size: var(--role-sub-size) !important;
  margin-top: 8rpx !important;
}

/* —— 功能宫格（对齐 C 端菜单可读性） —— */
.menu-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 20rpx 0;
}

.menu-tile {
  width: calc(50% - 8rpx);
  min-height: var(--role-menu-min-h);
  padding: 28rpx 24rpx;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 35, 41, 0.05);
  box-sizing: border-box;
  overflow: hidden;
}

.menu-tile__title {
  display: block;
  font-size: var(--role-title-size);
  font-weight: 800;
  color: #1f2329;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-tile__sub {
  display: -webkit-box;
  margin-top: 10rpx;
  font-size: var(--role-sub-size);
  color: #8f959e;
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  word-break: break-word;
}

/* —— 列表（商家订单 / 合伙人账目 / 创始人名单等） —— */
.role-list,
.m-list--spaced {
  display: flex;
  flex-direction: column;
  gap: var(--role-card-gap);
}

.role-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: var(--role-card-min-h);
  padding: var(--role-card-pad);
  background: #fff;
  border-radius: var(--role-card-radius);
  box-shadow: 0 6rpx 20rpx rgba(31, 35, 41, 0.05);
  box-sizing: border-box;
}

.role-card__seal {
  width: var(--role-seal-size);
  height: var(--role-seal-size);
  border-radius: 20rpx;
  background: #fff1f0;
  color: #ff4d4f;
  font-size: 26rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.role-card__cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  background: #f3f0ec;
  overflow: hidden;
}

.role-card__main {
  flex: 1;
  min-width: 0;
}

.role-card__title {
  display: -webkit-box;
  font-size: var(--role-title-size);
  font-weight: 800;
  color: #1f2329;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  word-break: break-word;
  white-space: normal;
}

.role-card__sub {
  display: -webkit-box;
  margin-top: 10rpx;
  font-size: var(--role-sub-size);
  color: #8f959e;
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  word-break: break-word;
  white-space: normal;
}

.role-card__side {
  flex-shrink: 0;
  max-width: 34%;
  text-align: right;
}

.role-card__amt {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #ff4d4f;
  line-height: 1.25;
}

.role-card__amt.amt--down {
  color: #1f2329;
}

.role-card--stack {
  flex-wrap: wrap;
  align-items: flex-start;
}

.role-card--stack .role-card__main {
  flex: 1;
  min-width: 0;
}

.role-card--stack .role-card__side {
  max-width: none;
}

.role-card__actions {
  width: 100%;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 16rpx;
  padding-left: calc(var(--role-seal-size) + 20rpx);
  box-sizing: border-box;
}

.role-card__actions .btn-primary,
.role-card__actions .btn-ghost,
.role-card__actions .sm {
  margin: 0;
  min-width: 128rpx;
  min-height: 64rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
  line-height: 64rpx;
}

/* KPI 条 */
.role-kpi-row {
  display: flex;
  margin: 20rpx 0;
  background: #fff;
  border-radius: var(--role-card-radius);
  box-shadow: 0 6rpx 20rpx rgba(31, 35, 41, 0.05);
  overflow: hidden;
}

.role-kpi {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 28rpx 8rpx;
}

.role-kpi__v {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #ff4d4f;
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.role-kpi__l {
  display: block;
  margin-top: 8rpx;
  font-size: var(--role-sub-size);
  color: #8f959e;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 页头 */
.m-page-head {
  margin-bottom: 20rpx;
  padding: 28rpx;
  background: #fff;
  border-radius: var(--role-card-radius);
  box-shadow: 0 6rpx 20rpx rgba(31, 35, 41, 0.05);
  box-sizing: border-box;
}

.m-page-head__title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: #1f2329;
  line-height: 1.3;
}

.m-page-head__desc {
  display: block;
  margin-top: 10rpx;
  font-size: var(--role-sub-size);
  color: #8f959e;
  line-height: 1.45;
}

/* 操作按钮栈：保证文字完整 */
.action-stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin: 24rpx 0;
}

.action-stack .btn-outline-primary,
.action-stack .btn-gradient {
  min-height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.empty {
  padding: 96rpx 24rpx;
  text-align: center;
  color: #8f959e;
  font-size: 28rpx;
  line-height: 1.5;
}

/* 覆盖旧版矮行 .row */
.page--tabbed .row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: var(--role-card-min-h);
  padding: var(--role-card-pad);
  margin-bottom: var(--role-card-gap);
  background: #fff;
  border-radius: var(--role-card-radius);
  box-shadow: 0 6rpx 20rpx rgba(31, 35, 41, 0.05);
  box-sizing: border-box;
}

.page--tabbed .row__t {
  display: -webkit-box;
  font-size: var(--role-title-size);
  font-weight: 800;
  color: #1f2329;
  line-height: 1.35;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  word-break: break-word;
}

.page--tabbed .row__s,
.page--tabbed .row__d {
  display: -webkit-box;
  margin-top: 10rpx;
  font-size: var(--role-sub-size);
  color: #8f959e;
  line-height: 1.45;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  word-break: break-word;
}

.page--tabbed .row__amt {
  font-size: 30rpx;
  font-weight: 800;
  color: #ff4d4f;
}

/* 创始人审核卡 */
.page--tabbed .card {
  min-height: var(--role-card-min-h);
  padding: var(--role-card-pad);
  margin-bottom: var(--role-card-gap);
  background: #fff;
  border-radius: var(--role-card-radius);
  box-shadow: 0 6rpx 20rpx rgba(31, 35, 41, 0.05);
  box-sizing: border-box;
}

.page--tabbed .card__title {
  font-size: var(--role-title-size);
  font-weight: 800;
  color: #1f2329;
  line-height: 1.35;
  word-break: break-word;
}

.page--tabbed .card__meta {
  margin-top: 10rpx;
  font-size: var(--role-sub-size);
  color: #8f959e;
  line-height: 1.45;
  word-break: break-word;
}

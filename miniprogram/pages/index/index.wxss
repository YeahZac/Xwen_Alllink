/* mall-hub · 本地生活枢纽首页 */
.mall-page {
  background: var(--color-bg);
  min-height: 100vh;
}

.counter-head {
  background: #fff;
  padding-left: var(--space-page);
  padding-right: var(--space-page);
  padding-bottom: var(--space-md);
  position: relative;
  overflow: hidden;
  border-bottom: 1rpx solid var(--color-border);
}

.counter-head::after {
  display: none;
}

.counter-head__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
  margin-bottom: var(--space-md);
  position: relative;
  z-index: 1;
}

.counter-brand {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  min-width: 0;
  flex: 1;
}

.counter-brand--center {
  flex: 1;
  justify-content: center;
  text-align: center;
}

.counter-brand--center .counter-brand__text {
  align-items: center;
}

.counter-brand--center .counter-brand__name,
.counter-brand--center .counter-brand__line {
  text-align: center;
}

.loc-chip--lead {
  flex: 0 1 28%;
  max-width: 28%;
  justify-content: flex-start;
  padding: 6rpx 0;
}

.counter-brand__seal {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 36rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: inset 0 0 0 3rpx rgba(255, 255, 255, 0.32);
}

.counter-brand__scan {
  width: 68rpx;
  height: 68rpx;
  border-radius: 18rpx;
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.counter-brand__scan--active {
  opacity: 0.86;
}

.scan-ico {
  position: relative;
  width: 36rpx;
  height: 36rpx;
}

.scan-ico__corner {
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  border-color: #fff;
  border-style: solid;
}

.scan-ico__corner--tl {
  left: 0;
  top: 0;
  border-width: 3rpx 0 0 3rpx;
}

.scan-ico__corner--tr {
  right: 0;
  top: 0;
  border-width: 3rpx 3rpx 0 0;
}

.scan-ico__corner--bl {
  left: 0;
  bottom: 0;
  border-width: 0 0 3rpx 3rpx;
}

.scan-ico__corner--br {
  right: 0;
  bottom: 0;
  border-width: 0 3rpx 3rpx 0;
}

.scan-ico__beam {
  position: absolute;
  left: 4rpx;
  right: 4rpx;
  top: 50%;
  height: 3rpx;
  margin-top: -1rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 2rpx;
}

.counter-brand__text {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.counter-brand__name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-ink);
  letter-spacing: 0.02em;
  line-height: 1.15;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.counter-brand__line {
  font-size: var(--font-small);
  color: var(--color-text-muted);
  line-height: 1.3;
  font-weight: 500;
}

.loc-chip {
  display: flex;
  align-items: center;
  gap: 4rpx;
  max-width: 100%;
  padding: 6rpx 0;
  min-width: 0;
}

.loc-chip__pin {
  position: relative;
  width: 22rpx;
  height: 22rpx;
  border: 3rpx solid var(--color-primary);
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
  margin-right: 4rpx;
  flex-shrink: 0;
}

.loc-chip__pin::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: var(--color-primary);
  transform: translate(-50%, -50%);
}

.loc-chip__t {
  font-size: var(--font-small);
  color: var(--color-ink);
  font-weight: 600;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.loc-chip__gps {
  flex-shrink: 0;
  font-size: var(--font-tiny);
  font-weight: 700;
  color: var(--color-primary);
  letter-spacing: 0.04em;
}

.search-bar__ico {
  position: relative;
  width: 26rpx;
  height: 26rpx;
  border: 3rpx solid #B0B6BE;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.search-bar__ico::after {
  content: "";
  position: absolute;
  right: -9rpx;
  bottom: -6rpx;
  width: 12rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: #B0B6BE;
  transform: rotate(45deg);
  transform-origin: left center;
}

.scan-chip {
  display: none;
}

.scan-chip__t {
  font-size: var(--font-small);
  font-weight: 800;
  color: #fff;
  letter-spacing: 0.08em;
}

.search-bar--dark {
  display: flex;
  align-items: center;
  background: #F4F5F7;
  border-radius: 999rpx;
  padding: 6rpx 6rpx 6rpx 24rpx;
  min-height: 76rpx;
  position: relative;
  z-index: 1;
  border: none;
}

.search-bar__input--dark {
  flex: 1;
  height: 64rpx;
  font-size: 26rpx;
  color: var(--color-ink);
  background: transparent;
}

.search-ph {
  color: #B0B6BE;
}

.search-bar__btn--red {
  padding: 0 32rpx;
  height: 64rpx;
  line-height: 64rpx;
  background: var(--color-primary);
  color: #fff;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 800;
  letter-spacing: 0.06em;
  flex-shrink: 0;
}

.mall-body--counter {
  padding: var(--space-md) var(--space-page) calc(var(--space-lg) + env(safe-area-inset-bottom));
  margin-top: 0;
}

.entry-rail {
  display: flex;
  align-items: stretch;
  gap: 0;
  margin-bottom: var(--space-md);
  padding: 28rpx 4rpx 24rpx;
  background: #fff;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-soft);
}

.entry {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 12rpx;
  padding: 0;
}

.entry:active {
  opacity: 0.72;
}

.entry__bubble {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.entry__bubble--order {
  background: #FFF1F0;
}

.entry__bubble--points {
  background: #FFF7E8;
}

.entry__bubble--invite {
  background: #F0F5FF;
}

.entry__bubble--shop {
  background: #E8F8F2;
}

.entry__bubble--need {
  background: #F9F0FF;
}

.entry__ico {
  width: 40rpx;
  height: 40rpx;
  position: relative;
}

.entry__ico--order {
  border: 3rpx solid var(--color-ink);
  border-radius: 8rpx;
}

.entry__ico--order::before,
.entry__ico--order::after {
  content: "";
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  height: 3rpx;
  background: var(--color-ink);
  border-radius: 2rpx;
}

.entry__ico--order::before {
  top: 12rpx;
}

.entry__ico--order::after {
  top: 22rpx;
}

.entry__ico--points {
  border: 3rpx solid var(--color-primary);
  border-radius: 50%;
}

.entry__ico--points::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 12rpx;
  height: 12rpx;
  margin: -6rpx 0 0 -6rpx;
  background: var(--color-primary);
  border-radius: 50%;
}

.entry__ico--invite {
  width: 56rpx;
}

.entry__ico--invite::before,
.entry__ico--invite::after {
  content: "";
  position: absolute;
  top: 6rpx;
  width: 14rpx;
  height: 14rpx;
  border: 3rpx solid var(--color-ink);
  border-radius: 50%;
}

.entry__ico--invite::before {
  left: 2rpx;
}

.entry__ico--invite::after {
  right: 2rpx;
}

.entry__ico--shop {
  border: 3rpx solid var(--color-ink);
  border-radius: 6rpx;
}

.entry__ico--shop::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 14rpx;
  height: 16rpx;
  margin-left: -7rpx;
  border-left: 3rpx solid var(--color-ink);
  border-right: 3rpx solid var(--color-ink);
}

.entry__ico--need {
  border: 3rpx solid var(--color-ink);
  border-radius: 50% 50% 50% 4rpx;
  transform: rotate(-18deg);
}

.entry__t {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-ink);
  letter-spacing: 0.02em;
}

.entry__s {
  display: none;
}

.cat-rail {
  width: 100%;
  white-space: nowrap;
  margin: 0;
  padding: 0 20rpx 16rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.cat-chip {
  display: inline-flex;
  align-items: center;
  height: 52rpx;
  padding: 0 20rpx;
  margin-right: 10rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-text-secondary);
  background: #F4F5F7;
  border-radius: 999rpx;
  vertical-align: middle;
}

.cat-chip--on {
  color: var(--color-primary);
  background: var(--color-primary-soft);
}

.feed {
  background: #fff;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-soft);
  margin-bottom: var(--space-md);
}

.feed__top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  padding: 28rpx 24rpx 8rpx;
}

.feed__title {
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-ink);
  letter-spacing: 0.01em;
}

.sort-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex-shrink: 0;
}

.sort {
  font-size: var(--font-small);
  font-weight: 700;
  color: var(--color-text-muted);
}

.sort--on {
  color: var(--color-primary);
}

.sec-tabs {
  display: flex;
  gap: 8rpx;
  padding: 8rpx 16rpx 4rpx;
}

.sec-tab {
  padding: 14rpx 20rpx 16rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: var(--color-text-secondary);
  background: transparent;
  border-radius: 0;
  position: relative;
}

.sec-tab--on {
  color: var(--color-ink);
  background: transparent;
}

.sec-tab--on::after {
  content: "";
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 4rpx;
  height: 6rpx;
  border-radius: 6rpx;
  background: var(--color-primary);
}

.empty-state--feed {
  padding: 48rpx 24rpx 56rpx;
}

.city-mask {
  position: fixed;
  inset: 0;
  z-index: 40;
  background: rgba(18, 20, 26, 0.45);
}

.city-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 41;
  background: #fff;
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  padding: 12rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  transform: translateY(110%);
  pointer-events: none;
  transition: transform var(--dur-mid) var(--ease-out);
}

.city-sheet--on {
  transform: translateY(0);
  pointer-events: auto;
}

.city-sheet__grab {
  width: 64rpx;
  height: 8rpx;
  margin: 8rpx auto 20rpx;
  background: var(--color-border);
  border-radius: 8rpx;
}

.city-sheet__title {
  display: block;
  font-size: var(--font-title);
  font-weight: 800;
  margin-bottom: var(--space-sm);
}

.city-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
}

.city-row:active {
  opacity: 0.7;
}

.city-row__name {
  font-size: var(--font-body);
  font-weight: 700;
  color: var(--color-ink);
}

.city-row--on .city-row__name {
  color: var(--color-primary);
}

.city-row__side {
  font-size: var(--font-caption);
  font-weight: 700;
  color: var(--color-primary);
}

/* —— 点评式单列店卡（白底连排） —— */
.shop-card {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 0;
  background: #fff;
  border-radius: 0;
  box-shadow: none;
  border-bottom: 1rpx solid #F0F1F3;
}

.shop-card:last-child {
  border-bottom: none;
}

.shop-card:active {
  opacity: 0.94;
  transform: none;
  background: #FAFBFC;
}

.shop-card__cover {
  width: 176rpx;
  height: 176rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: var(--color-surface-soft);
}

.cover-fallback--shop {
  font-size: 56rpx;
}

.shop-card__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.shop-card__title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.shop-card__name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-ink);
  line-height: 1.3;
}

.shop-card__tag {
  flex-shrink: 0;
  padding: 2rpx 10rpx;
  border: 1rpx solid var(--color-primary);
  color: var(--color-primary);
  font-size: var(--font-tiny);
  font-weight: 700;
  border-radius: 6rpx;
  letter-spacing: 0.04em;
}

.shop-card__stats {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 8rpx;
}

.shop-card__star {
  font-size: 26rpx;
  font-weight: 800;
  color: var(--color-primary);
  font-variant-numeric: tabular-nums;
  line-height: 1;
}

.shop-card__meta {
  font-size: var(--font-small);
  color: var(--color-text-muted);
  font-variant-numeric: tabular-nums;
}

.shop-card__desc {
  margin-top: 6rpx;
  font-size: var(--font-small);
  color: var(--color-text-secondary);
  line-height: 1.35;
}

.shop-card__vouchers {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.shop-card__voucher {
  display: inline-flex;
  max-width: 100%;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  border: 1rpx solid rgba(255, 77, 79, 0.35);
  color: var(--color-primary-deep);
  font-size: var(--font-tiny);
  font-weight: 600;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shop-card__foot {
  margin-top: 12rpx;
  padding-top: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.shop-card__hint {
  font-size: var(--font-tiny);
  color: var(--color-text-muted);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shop-card__cta {
  flex-shrink: 0;
  padding: 12rpx 28rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: var(--font-small);
  font-weight: 600;
  border-radius: var(--radius-pill);
  letter-spacing: 0.02em;
  box-shadow: none;
}

.shop-card__cta:active {
  opacity: 0.9;
}

/* 积分福利条 */
.promo-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: var(--space-sm);
  margin-bottom: var(--space-md);
  padding: 20rpx 22rpx;
  background: var(--color-primary-soft);
  border-radius: var(--radius-lg);
  box-shadow: none;
  border: none;
}

.promo-card:active {
  opacity: 0.94;
}

.promo-card__ico {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 24rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.promo-card__main {
  flex: 1;
  min-width: 0;
}

.promo-card__title {
  display: block;
  font-size: 26rpx;
  font-weight: 800;
  color: var(--color-ink);
}

.promo-card__sub {
  display: block;
  margin-top: 4rpx;
  font-size: var(--font-tiny);
  color: var(--color-text-muted);
}

.promo-card__go {
  flex-shrink: 0;
  font-size: var(--font-small);
  font-weight: 800;
  color: var(--color-primary);
}

.soft-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 4rpx;
}

.soft-link--sub {
  padding-top: 0;
}

.soft-link__t {
  font-size: 24rpx;
  color: var(--color-text-muted);
}

.soft-link__a {
  font-size: 24rpx;
  font-weight: 800;
  color: var(--color-primary);
}

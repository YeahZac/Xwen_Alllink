.points.page--flush {
  padding-bottom: calc(var(--space-lg) + env(safe-area-inset-bottom));
  background: var(--color-bg);
}

.wallet {
  padding: 24rpx var(--space-page) 8rpx;
  background: linear-gradient(180deg, #fff1f0 0%, var(--color-bg) 100%);
}

.wallet__card {
  position: relative;
  overflow: hidden;
  padding: 28rpx 28rpx 24rpx;
  border-radius: var(--radius-xl);
  background: linear-gradient(145deg, #ff7875 0%, #ff4d4f 55%, #e03436 100%);
  box-shadow: 0 12rpx 28rpx rgba(255, 77, 79, 0.22);
}

.wallet__card::before,
.wallet__card::after {
  display: none;
}

.wallet__head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.wallet__label {
  font-size: 24rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.82);
  letter-spacing: 0.04em;
}

.wallet__rate {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  color: rgba(255, 255, 255, 0.92);
  font-size: var(--font-tiny);
  font-weight: 700;
  letter-spacing: 0.02em;
}

.wallet__body {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 28rpx;
}

.wallet__num {
  flex: 1;
  min-width: 0;
  font-size: 88rpx;
  font-weight: 800;
  line-height: 0.95;
  letter-spacing: -0.03em;
  color: #fff;
  font-variant-numeric: tabular-nums;
}

.wallet__cash {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  padding-bottom: 8rpx;
}

.wallet__cash-l {
  font-size: var(--font-tiny);
  font-weight: 600;
  color: rgba(255, 255, 255, 0.72);
}

.wallet__cash-v {
  font-size: 32rpx;
  font-weight: 800;
  color: #fff;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.01em;
}

.wallet__cta {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 96rpx;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 6rpx 18rpx rgba(18, 20, 26, 0.06);
}

.wallet__cta--active {
  opacity: 0.92;
  transform: scale(0.99);
}

.wallet__cta-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.wallet__cta-t {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--color-ink);
  line-height: 1.2;
}

.wallet__cta-s {
  font-size: var(--font-small);
  color: var(--color-text-muted);
  line-height: 1.3;
}

.wallet__cta-arrow {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(255, 106, 42, 0.12);
  color: var(--color-primary);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 44rpx;
  text-align: center;
}

.ledger-sheet {
  margin: 8rpx var(--space-page) var(--space-md);
  position: relative;
  z-index: 2;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 28rpx rgba(18, 20, 26, 0.06);
  padding-bottom: 8rpx;
}

.sheet-label {
  display: block;
  padding: 24rpx 24rpx 4rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: var(--color-ink);
}

.sheet-desc {
  display: block;
  padding: 0 24rpx 12rpx;
  font-size: var(--font-small);
  color: var(--color-text-muted);
}

.ledger {
  padding: 24rpx;
  margin-bottom: 0;
  gap: var(--space-md);
  border-top: 1rpx solid #F0F1F3;
}

.ledger__main {
  flex: 1;
  min-width: 0;
}

.ledger__title {
  display: block;
  font-weight: 700;
  margin-bottom: var(--space-2);
  font-size: var(--font-subtitle);
  line-height: var(--lh-snug);
}

.ledger__change {
  font-size: var(--font-lead);
  font-weight: 800;
  flex-shrink: 0;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.ledger__change.up {
  color: var(--color-success);
}

.ledger__change.down {
  color: var(--color-text-secondary);
}

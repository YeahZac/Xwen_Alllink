<view class="page identity">
  <text class="identity__lead">同一微信可切换消费者、商家、合伙人等身份。未开通可在线申请，审核通过后即可使用。</text>

  <view class="id-cards">
    <view
      wx:for="{{identityCards}}"
      wx:key="role"
      class="id-card {{item.active ? 'id-card--active' : ''}} {{item.opened ? '' : 'id-card--locked'}}"
      bindtap="onIdentityTap"
      data-role="{{item.role}}"
      data-opened="{{item.opened}}"
      data-pending="{{item.pending}}"
      data-active="{{item.active}}"
      data-merchant-id="{{item.merchantId}}"
      data-apply-path="{{item.applyPath}}"
      data-apply-title="{{item.applyTitle}}"
      data-badge="{{item.badge}}"
      data-label="{{item.label}}"
    >
      <view class="id-card__seal">{{item.seal}}</view>
      <view class="id-card__main">
        <view class="id-card__top">
          <text class="id-card__title">{{item.label}}</text>
          <text class="id-card__badge {{item.opened ? 'id-card__badge--ok' : (item.pending ? 'id-card__badge--pending' : 'id-card__badge--off')}}">{{item.badge}}</text>
        </view>
        <text class="id-card__desc">{{item.shopName || item.desc}}</text>
      </view>
      <text class="id-card__arrow">›</text>
    </view>
  </view>
</view>

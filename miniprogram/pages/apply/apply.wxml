<view class="page apply">
  <!-- 步骤条：轻量 WeUI 风格 -->
  <view class="steps">
    <view class="steps__item {{step >= 1 ? 'is-on' : ''}}">
      <view class="steps__dot">1</view>
      <text class="steps__txt">选类型</text>
    </view>
    <view class="steps__line {{step >= 2 ? 'is-on' : ''}}"></view>
    <view class="steps__item {{step >= 2 ? 'is-on' : ''}}">
      <view class="steps__dot">2</view>
      <text class="steps__txt">填资料</text>
    </view>
    <view class="steps__line {{step >= 3 ? 'is-on' : ''}}"></view>
    <view class="steps__item {{step >= 3 ? 'is-on' : ''}}">
      <view class="steps__dot">3</view>
      <text class="steps__txt">{{isStall ? '核验' : '证照'}}</text>
    </view>
  </view>

  <!-- Step 1 -->
  <block wx:if="{{step === 1}}">
    <view class="panel">
      <view class="panel__hd">选择经营类型</view>
      <view class="panel__bd">
        <radio-group bindchange="onRoleChange">
          <label
            class="cell cell--access"
            wx:for="{{types}}"
            wx:key="id"
            data-id="{{item.id}}"
          >
            <view class="cell__bd">
              <view class="cell__title">{{item.name}}</view>
              <view class="cell__desc">{{item.desc}}</view>
            </view>
            <view class="cell__ft">
              <radio value="{{item.id}}" checked="{{selected === item.id}}" color="#FA5151" />
            </view>
          </label>
        </radio-group>
      </view>
    </view>
    <view class="foot-bar">
      <button class="btn-main" bindtap="nextStep">下一步</button>
    </view>
  </block>

  <!-- Step 2 -->
  <block wx:if="{{step === 2}}">
    <view class="panel">
      <view class="panel__hd">{{roleLabel}} · 主体资料</view>
      <view class="panel__bd">
        <view class="cell" wx:for="{{baseFields}}" wx:key="key">
          <view class="cell__hd">
            <text>{{item.label}}</text>
            <text class="req" wx:if="{{item.required}}">*</text>
          </view>
          <view class="cell__bd cell__bd--input">
            <input
              class="cell__input"
              placeholder="{{item.placeholder || ('请输入' + item.label)}}"
              placeholder-class="ph"
              value="{{form[item.key]}}"
              data-key="{{item.key}}"
              bindinput="onField"
              type="{{item.type || 'text'}}"
              maxlength="{{item.maxLength || 140}}"
            />
          </view>
        </view>
        <view class="cell cell--access" bindtap="chooseLocation">
          <view class="cell__hd">地图定位<text class="req">*</text></view>
          <view class="cell__bd cell__bd--right">
            <text class="{{locationText ? 'cell__value' : 'ph'}}">{{locationText || '点击选点'}}</text>
          </view>
          <view class="cell__ft cell__arrow">›</view>
        </view>
        <view class="cell cell--top">
          <view class="cell__hd">详细地址<text class="req">*</text></view>
          <view class="cell__bd cell__bd--input">
            <textarea
              class="cell__textarea"
              placeholder="地图识别地址，可修改"
              placeholder-class="ph"
              value="{{form.address}}"
              bindinput="onAddressInput"
              maxlength="200"
              auto-height
            />
          </view>
        </view>
      </view>
    </view>
    <view class="tips" wx:if="{{locationName}}">地点：{{locationName}}</view>
    <view class="foot-bar foot-bar--row">
      <button class="btn-ghost" bindtap="prevStep">上一步</button>
      <button class="btn-main" bindtap="nextStep">下一步</button>
    </view>
  </block>

  <!-- Step 3 -->
  <block wx:if="{{step === 3}}">
    <view class="panel" wx:if="{{isStall}}">
      <view class="panel__hd">地摊说明</view>
      <view class="panel__bd panel__bd--pad">
        <text class="tips-inline">无营业执照也可申请。需核验本人身份与摊位实景，并签署合规承诺；摆摊须遵守属地规定。</text>
      </view>
    </view>

    <view class="panel">
      <view class="panel__hd">{{step3Title}}</view>
      <view class="panel__bd panel__bd--pad">
        <view class="uploader" wx:for="{{licenseFields}}" wx:key="key">
          <view class="uploader__label">
            {{item.label}}<text class="req" wx:if="{{item.required}}">*</text>
            <text class="uploader__tip" wx:if="{{item.tip}}">{{item.tip}}</text>
          </view>
          <view class="uploader__files">
            <view class="uploader__item" bindtap="chooseImage" data-key="{{item.key}}">
              <image wx:if="{{files[item.key]}}" class="uploader__img" src="{{files[item.key]}}" mode="aspectFill" />
              <view wx:else class="uploader__add">
                <text class="uploader__plus">+</text>
                <text class="uploader__add-txt">上传</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="panel">
      <view class="panel__bd">
        <checkbox-group wx:if="{{isStall}}" bindchange="onStallCommitChange">
          <label class="cell cell--check">
            <checkbox value="1" checked="{{form.stallCommitment}}" color="#FA5151" />
            <view class="cell__bd">
              <text class="check-text">我承诺本人为实际经营者，所售符合安全要求，服从属地监管；虚假材料同意驳回或关停。</text>
            </view>
          </label>
        </checkbox-group>
        <checkbox-group bindchange="onAgreeChange">
          <label class="cell cell--check">
            <checkbox value="1" checked="{{form.agreed}}" color="#FA5151" />
            <view class="cell__bd">
              <text class="check-text">提交申请并通过审核即视为同意</text>
              <text class="link" catchtap="openMerchantLegal">《商户入驻平台协议》</text>
              <text class="check-text">（协议内已按本店信息自动填充）</text>
            </view>
          </label>
        </checkbox-group>
      </view>
    </view>

    <view class="foot-bar foot-bar--row">
      <button class="btn-ghost" bindtap="prevStep">上一步</button>
      <button class="btn-main" bindtap="submit" loading="{{submitting}}">提交申请</button>
    </view>
  </block>

  <view class="link-row" bindtap="queryStatus">
    <text>已有申请？查询审核进度</text>
  </view>
</view>

/* WeUI 风格入驻：白底单元格 + 标准按钮，少装饰 */

.page.apply {
  min-height: 100vh;
  background: #ededed;
  padding: 0 0 calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 步骤 */
.steps {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 32rpx 8rpx;
  background: #fff;
  margin-bottom: 24rpx;
}

.steps__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  color: #999;
}

.steps__dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #e5e5e5;
  color: #666;
  font-size: 22rpx;
  line-height: 40rpx;
  text-align: center;
  font-weight: 600;
}

.steps__txt {
  font-size: 22rpx;
}

.steps__item.is-on {
  color: #fa5151;
}

.steps__item.is-on .steps__dot {
  background: #fa5151;
  color: #fff;
}

.steps__line {
  width: 56rpx;
  height: 2rpx;
  background: #e5e5e5;
  margin: 0 12rpx 28rpx;
}

.steps__line.is-on {
  background: #fa5151;
}

/* 面板 */
.panel {
  margin: 0 0 24rpx;
  background: #fff;
}

.panel__hd {
  padding: 26rpx 32rpx 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #191919;
}

.panel__bd--pad {
  padding: 8rpx 32rpx 28rpx;
}

.tips-inline {
  font-size: 24rpx;
  color: #888;
  line-height: 1.55;
}

.tips {
  margin: -8rpx 32rpx 24rpx;
  font-size: 22rpx;
  color: #888;
}

/* 单元格 */
.cell {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 20rpx 32rpx;
  box-sizing: border-box;
  position: relative;
  background: #fff;
}

.cell::after {
  content: '';
  position: absolute;
  left: 32rpx;
  right: 0;
  bottom: 0;
  height: 1rpx;
  background: #e5e5e5;
  transform: scaleY(0.5);
}

.cell:last-child::after {
  display: none;
}

.cell--access:active {
  background: #f7f7f7;
}

.cell--top {
  align-items: flex-start;
}

.cell--check {
  align-items: flex-start;
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}

.cell__hd {
  flex-shrink: 0;
  width: 200rpx;
  font-size: 28rpx;
  color: #191919;
  line-height: 1.4;
}

.cell__bd {
  flex: 1;
  min-width: 0;
}

.cell__bd--input {
  text-align: right;
}

.cell__bd--right {
  text-align: right;
}

.cell__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #191919;
  line-height: 1.35;
}

.cell__desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #888;
  line-height: 1.45;
}

.cell__input {
  width: 100%;
  height: 48rpx;
  font-size: 28rpx;
  color: #191919;
  text-align: right;
}

.cell__textarea {
  width: 100%;
  min-height: 80rpx;
  font-size: 28rpx;
  color: #191919;
  text-align: right;
  line-height: 1.45;
}

.cell__value {
  font-size: 28rpx;
  color: #191919;
}

.cell__ft {
  margin-left: 12rpx;
  flex-shrink: 0;
}

.cell__arrow {
  color: #c0c0c0;
  font-size: 32rpx;
  line-height: 1;
}

.ph {
  color: #b2b2b2;
  font-size: 28rpx;
}

.req {
  color: #fa5151;
  margin-left: 4rpx;
}

.check-text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

.link {
  color: #576b95;
  font-size: 24rpx;
}

/* 上传：WeUI uploader 方格 */
.uploader {
  margin-bottom: 28rpx;
}

.uploader:last-child {
  margin-bottom: 0;
}

.uploader__label {
  font-size: 28rpx;
  color: #191919;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.uploader__tip {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #888;
  font-weight: 400;
}

.uploader__files {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.uploader__item {
  width: 160rpx;
  height: 160rpx;
  background: #ededed;
  border-radius: 8rpx;
  overflow: hidden;
}

.uploader__img {
  width: 100%;
  height: 100%;
}

.uploader__add {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  border: 1rpx dashed #cfcfcf;
  box-sizing: border-box;
  border-radius: 8rpx;
  background: #fafafa;
}

.uploader__plus {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
  font-weight: 300;
}

.uploader__add-txt {
  font-size: 22rpx;
  color: #999;
}

/* 底部固定操作区（微信常见模式） */
.foot-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -1rpx 0 #e5e5e5;
  box-sizing: border-box;
}

.foot-bar--row {
  display: flex;
  gap: 24rpx;
}

.btn-main {
  flex: 1;
  margin: 0 !important;
  height: 88rpx;
  line-height: 88rpx;
  background: #fa5151 !important;
  color: #fff !important;
  font-size: 32rpx !important;
  font-weight: 600;
  border-radius: 8rpx !important;
  border: none !important;
}

.btn-main::after {
  border: none;
}

.btn-ghost {
  flex: 1;
  margin: 0 !important;
  height: 88rpx;
  line-height: 88rpx;
  background: #fff !important;
  color: #191919 !important;
  font-size: 32rpx !important;
  border-radius: 8rpx !important;
  border: 1rpx solid #d9d9d9 !important;
}

.btn-ghost::after {
  border: none;
}

.link-row {
  margin: 24rpx 0 8rpx;
  padding: 16rpx;
  text-align: center;
  font-size: 26rpx;
  color: #576b95;
}

.steps {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-md) var(--space-sm);
  margin-bottom: var(--space-sm);
}

.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-xs);
  color: var(--color-text-muted);
  font-size: var(--font-small);
}

.step text:first-child {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: var(--radius-xs);
  background: var(--color-surface-soft);
  font-weight: 800;
}

.step--on {
  color: var(--color-primary-deep);
}

.step--on text:first-child {
  background: var(--color-primary);
  color: #fff;
  border-color: transparent;
  box-shadow: var(--shadow-seal);
}

.step-line {
  width: 48rpx;
  height: 4rpx;
  background: var(--color-border);
  margin: 0 var(--space-xs);
  margin-bottom: var(--space-lg);
  border-radius: 2rpx;
}

.step-line--on {
  background: var(--color-primary);
}

.type {
  padding: var(--space-md);
  margin-bottom: var(--space-sm);
  background: var(--color-surface);
}

.type--on {
  background: var(--color-primary-soft);
}

.type__name {
  display: block;
  font-size: var(--font-subtitle);
  font-weight: 800;
  margin-bottom: var(--space-2);
  line-height: var(--lh-snug);
}

.type__tags {
  margin-top: var(--space-sm);
  display: flex;
  gap: var(--space-xs);
  flex-wrap: wrap;
}

.form {
  padding: var(--space-xs) 0 var(--space-sm);
  margin-bottom: var(--space-md);
}

.field {
  padding: var(--space-md) 0;
  border-bottom: 1rpx solid var(--color-border);
}

.field:last-child {
  border-bottom: none;
}

.field__label {
  display: block;
  font-size: var(--font-tiny);
  font-weight: 700;
  letter-spacing: var(--tracking-label);
  margin-bottom: var(--space-sm);
  color: var(--color-text-secondary);
}

.req {
  color: var(--color-primary);
  margin-left: var(--space-2);
}

.field__input {
  height: 72rpx;
  padding: 0 var(--space-md);
  background: var(--color-surface-soft);
  border-radius: var(--radius-md);
  font-size: var(--font-body);
  border: 1rpx solid transparent;
}

.field__pick {
  min-height: 72rpx;
  padding: 18rpx var(--space-md);
  background: var(--color-surface-soft);
  border-radius: var(--radius-md);
  font-size: var(--font-body);
  line-height: 1.4;
}

.field__area {
  width: 100%;
  min-height: 120rpx;
  padding: 18rpx var(--space-md);
  box-sizing: border-box;
  background: var(--color-surface-soft);
  border-radius: var(--radius-md);
  font-size: var(--font-body);
  line-height: 1.5;
}

.field__tip {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
  line-height: 1.4;
}

.upload-list {
  margin-bottom: var(--space-md);
}

.upload {
  padding: var(--space-md);
  margin-bottom: var(--space-sm);
}

.upload__head {
  margin-bottom: var(--space-sm);
}

.upload__label {
  display: block;
  font-weight: 700;
  margin-bottom: var(--space-2);
  font-size: var(--font-body);
}

.upload__box {
  height: 220rpx;
  border-radius: var(--radius-md);
  border: 2rpx dashed var(--color-border-strong);
  overflow: hidden;
  background: var(--color-surface-soft);
}

.upload__preview {
  width: 100%;
  height: 100%;
}

.upload__placeholder {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--space-xs);
}

.upload__plus {
  font-size: var(--font-metric);
  color: var(--color-primary);
  line-height: 1;
  font-weight: 300;
}

.agree {
  display: flex;
  align-items: flex-start;
  gap: var(--space-sm);
  padding: var(--space-md);
  margin-bottom: var(--space-md);
}

.agree__check {
  width: 36rpx;
  height: 36rpx;
  border-radius: var(--radius-xs);
  border: 2rpx solid var(--color-border-strong);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-small);
  color: transparent;
  flex-shrink: 0;
}

.agree__check--on {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: #fff;
}

.agree__text {
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
  line-height: var(--lh-body);
}

.btns {
  display: flex;
  gap: var(--space-sm);
  margin-bottom: var(--space-md);
}

.half {
  flex: 1;
  width: auto !important;
  min-width: 0;
  font-size: var(--font-caption) !important;
  padding: 0 var(--space-sm) !important;
}

.query {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-md);
  font-size: var(--font-body);
  font-weight: 600;
}

.query:active {
  background: var(--color-surface-soft);
}

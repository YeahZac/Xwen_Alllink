<view class="page apply-identity">
  <text class="lead">申请「{{roleLabel}}」需填写真实联系人与手机号，提交后进入审核，通过后方可切换身份。</text>
  <view class="status-chip" wx:if="{{statusText}}">当前状态：{{statusText}}</view>
  <view class="form surface">
    <view class="field">
      <text class="field__label">申请身份</text>
      <text class="field__static">{{roleLabel}}</text>
    </view>
    <view class="field">
      <text class="field__label">姓名*</text>
      <input class="field__input" placeholder="请输入真实姓名" value="{{form.contactName}}" data-key="contactName" bindinput="onField" />
    </view>
    <view class="field">
      <text class="field__label">联系手机号*</text>
      <input class="field__input" type="number" maxlength="11" placeholder="11位手机号" value="{{form.contactPhone}}" data-key="contactPhone" bindinput="onField" />
    </view>
    <view class="field">
      <text class="field__label">所在城市</text>
      <input class="field__input" placeholder="如：深圳市" value="{{form.city}}" data-key="city" bindinput="onField" />
    </view>
    <view class="field">
      <text class="field__label">申请说明</text>
      <textarea class="field__area" placeholder="可说明资源、负责区域或合作背景" value="{{form.remark}}" data-key="remark" bindinput="onField" maxlength="200" />
    </view>
  </view>
  <button class="btn-primary" bindtap="submit" loading="{{submitting}}" disabled="{{submitting}}">提交申请</button>
</view>

<view class="page confirm">
  <text class="section-title">确认订单</text>
  <text class="section-desc">{{stall.name}} · 核对商品；积分可抵现，剩余走微信支付</text>

  <view wx:if="{{loading}}" class="empty-state">
    <text class="empty-state__title">正在核对订单</text>
    <text class="empty-state__desc">请稍候</text>
  </view>

  <block wx:else>
  <view class="surface block">
    <view wx:for="{{items}}" wx:key="lineKey" class="line row-between">
      <view class="line__main">
        <text class="line__name ellipsis-1">{{item.name}}</text>
        <text class="muted ellipsis-1" wx:if="{{item.optionsText}}">{{item.optionsText}}</text>
        <text class="muted">×{{item.qty}} · 单价 ¥{{item.price}}</text>
      </view>
      <text class="price"><text class="price__yen">¥</text>{{item.lineTotal}}</text>
    </view>
  </view>

  <view class="surface block summary">
    <view class="row-between line">
      <text>商品合计</text>
      <text class="price"><text class="price__yen">¥</text>{{summary.totalPrice}}</text>
    </view>
    <view class="row-between line">
      <text>可用积分</text>
      <text class="pts">{{points}}</text>
    </view>
    <view class="row-between line">
      <text>本单最多抵扣</text>
      <text class="pts">{{maxPoints}}</text>
    </view>
    <view class="mix">
      <view class="row-between">
        <text>使用积分</text>
        <view class="mix__acts">
          <text class="mix__chip" bindtap="useNone">不抵</text>
          <text class="mix__chip" bindtap="useHalf">一半</text>
          <text class="mix__chip" bindtap="useAll">全部</text>
        </view>
      </view>
      <input
        class="mix__input"
        type="number"
        value="{{pointsUse}}"
        bindinput="onPointsInput"
        placeholder="输入抵扣积分"
      />
    </view>
    <view class="row-between line">
      <text>积分抵现</text>
      <text>−¥{{offsetCash}}</text>
    </view>
    <view class="row-between line">
      <text>微信支付</text>
      <text class="price"><text class="price__yen">¥</text>{{cashDue}}</text>
    </view>
    <view class="row-between line">
      <text>预计划拨积分</text>
      <text class="pts">+{{summary.totalPoints}}</text>
    </view>
    <view class="hint muted">
      积分立即抵扣；现金走微信支付（未配商户号时模拟入账）。摊主完成出餐后，再从额度池划入消费积分。{{cashRateText}}
    </view>
  </view>

  <button class="btn-primary pay-btn" bindtap="onPay" loading="{{paying}}" disabled="{{paying}}">
    {{payLabel}}
  </button>
  </block>
</view>

.menu.page--flush {
  padding: 0;
  padding-bottom: calc(var(--space-md) + env(safe-area-inset-bottom));
  background: var(--color-bg);
}

.menu-shell {
  padding: var(--space-md) var(--space-page) var(--space-md);
}

.shop-info {
  display: flex;
  gap: var(--space-md);
  padding: var(--space-md);
  margin-bottom: var(--space-md);
  background: var(--color-surface);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-soft);
}

.shop-info__thumb {
  width: 148rpx;
  height: 148rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  flex-shrink: 0;
  background: var(--color-surface-soft);
}

.shop-info__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.shop-info__name {
  font-size: var(--font-title);
  font-weight: 800;
  color: var(--color-ink);
  line-height: var(--lh-snug);
}

.shop-info__desc {
  display: block;
  margin-top: 6rpx;
  font-size: var(--font-caption);
  color: var(--color-text-muted);
  line-height: var(--lh-snug);
}

.shop-info__tags {
  margin-top: var(--space-sm);
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-xs);
}

.menu-panel__head {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-bottom: var(--space-md);
}

.menu-panel__title {
  font-size: var(--font-title);
  font-weight: 800;
  color: var(--color-ink);
  letter-spacing: var(--tracking-display);
  line-height: var(--lh-tight);
}

.menu-panel__hint {
  font-size: var(--font-caption);
  color: var(--color-text-muted);
  line-height: var(--lh-snug);
}

.cat-block {
  margin-bottom: var(--space-sm);
}

.cat-name {
  display: block;
  margin: var(--space-xs) 0 var(--space-sm);
  font-size: var(--font-caption);
  font-weight: 700;
  color: var(--color-text-secondary);
}

.dish {
  display: flex;
  gap: var(--space-md);
  padding: var(--space-sm);
  margin-bottom: var(--space-sm);
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-soft);
}

.dish__thumb {
  width: 148rpx;
  height: 148rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  flex-shrink: 0;
  background: var(--color-surface-soft);
}

.dish__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.dish__name {
  font-size: var(--font-subtitle);
  font-weight: 800;
  color: var(--color-ink);
  line-height: var(--lh-snug);
}

.dish__desc {
  display: block;
  margin-top: var(--space-xs);
  font-size: var(--font-small);
  line-height: var(--lh-snug);
}

.dish__foot {
  margin-top: auto;
  padding-top: var(--space-sm);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-sm);
  min-width: 0;
}

.dish__foot .price {
  font-size: var(--font-lead);
}

.qty {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  flex-shrink: 0;
}

.qty__btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--color-surface-soft);
  color: var(--color-ink);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-subtitle);
  font-weight: 700;
}

.qty__btn--plus {
  background: var(--color-primary);
  color: #fff;
  box-shadow: var(--shadow-seal);
}

.qty__btn:active {
  opacity: 0.85;
}

.qty__n {
  min-width: 28rpx;
  text-align: center;
  font-weight: 800;
  font-size: var(--font-body);
  font-variant-numeric: tabular-nums;
}

.cart-bar__total {
  font-size: var(--font-lead);
  line-height: 1.2;
}

.cart-bar__qty {
  font-size: var(--font-small);
  color: var(--color-text-muted);
  font-weight: 600;
  line-height: var(--lh-snug);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(18, 20, 26, 0.45);
  z-index: 200;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 210;
  background: var(--color-surface);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  max-height: 78vh;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
}

.sheet__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-lg) var(--space-page) var(--space-sm);
  border-bottom: 1rpx solid var(--color-border);
}

.sheet__title {
  flex: 1;
  min-width: 0;
  margin-right: var(--space-sm);
  font-size: var(--font-title);
  font-weight: 800;
  color: var(--color-ink);
  line-height: var(--lh-tight);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sheet__close {
  flex-shrink: 0;
  font-size: var(--font-caption);
  color: var(--color-text-muted);
  font-weight: 600;
  padding: var(--space-xs) var(--space-sm);
}

.sheet__body {
  flex: 0 1 auto;
  min-height: 0;
  max-height: 48vh;
  padding: var(--space-xs) var(--space-page) var(--space-md);
  box-sizing: border-box;
}

.sheet-group {
  margin-top: var(--space-md);
}

.sheet-group__name {
  display: block;
  font-size: var(--font-subtitle);
  font-weight: 800;
  margin-bottom: var(--space-sm);
  color: var(--color-ink);
}

.sheet-opts {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
}

.sheet-opt {
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-sm);
  background: var(--color-surface-soft);
  font-size: var(--font-caption);
  font-weight: 600;
  color: var(--color-text);
  display: flex;
  align-items: center;
  gap: var(--space-xs);
}

.sheet-opt--on {
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
}

.sheet-opt__delta {
  color: var(--color-primary);
  font-weight: 700;
}

.sheet__foot {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  padding: var(--space-sm) var(--space-page) var(--space-md);
  border-top: 1rpx solid var(--color-border);
  flex-shrink: 0;
}

.sheet__price {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  overflow: hidden;
}

.sheet__add {
  width: 220rpx;
  max-width: 34%;
  min-width: 176rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: var(--font-subtitle);
  margin: 0;
  flex-shrink: 0;
}

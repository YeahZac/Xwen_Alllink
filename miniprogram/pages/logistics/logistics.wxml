<view class="page logistics" wx:if="{{listMode}}">
  <text class="section-title section-title--first">物流中心</text>
  <text class="section-desc">演示运单 · 贴近供应链采购配送场景</text>

  <view wx:if="{{!list.length}}" class="empty surface">
    <text class="empty__title">暂无物流单</text>
    <text class="muted">采购发货后会显示在这里</text>
  </view>

  <view
    wx:for="{{list}}"
    wx:key="orderNo"
    class="ship-card surface"
    bindtap="openItem"
    data-no="{{item.orderNo}}"
  >
    <view class="row-between">
      <text class="ship-card__title ellipsis-1">{{item.title}}</text>
      <text class="chip {{item.confirmed ? 'chip--off' : ''}}">{{item.statusText}}</text>
    </view>
    <text class="ship-card__meta muted">{{item.courier}} · {{item.trackingNo}}</text>
    <text class="ship-card__eta">{{item.etaText}}</text>
    <view class="ship-card__foot row-between">
      <text class="muted">{{item.sellerName}} → {{item.buyerName}}</text>
      <text class="ship-card__go">查看 ›</text>
    </view>
  </view>
</view>

<view class="page logistics" wx:elif="{{shipment}}">
  <view class="status-banner">
    <text class="status-banner__t">{{shipment.statusText}}</text>
    <text class="status-banner__s">{{shipment.etaText}}</text>
  </view>

  <view class="surface block">
    <view class="row-between">
      <text class="block__label">承运商</text>
      <text class="block__v">{{shipment.courier}}</text>
    </view>
    <view class="row-between track-row">
      <view class="track-main">
        <text class="block__label">运单号</text>
        <text class="track-no">{{shipment.trackingNo}}</text>
      </view>
      <view class="track-acts">
        <text class="link" bindtap="copyTracking">复制</text>
        <text class="link" bindtap="callCourier">联系快递</text>
      </view>
    </view>
  </view>

  <view class="surface block">
    <text class="block__h">收发信息</text>
    <view class="addr">
      <text class="addr__tag">寄</text>
      <view class="addr__body">
        <text class="addr__t">{{shipment.fromAddress}}</text>
        <text class="muted">{{shipment.sellerName}} · 发货 {{shipment.shippedAt}}</text>
      </view>
    </view>
    <view class="addr">
      <text class="addr__tag addr__tag--to">收</text>
      <view class="addr__body">
        <text class="addr__t">{{shipment.toAddress}}</text>
        <text class="muted">{{shipment.receiver}} {{shipment.receiverPhone}}</text>
      </view>
    </view>
  </view>

  <view class="surface block">
    <text class="block__h">货物明细</text>
    <view wx:for="{{shipment.goods}}" wx:key="sku" class="goods-line row-between">
      <text class="ellipsis-1">{{item.name}}</text>
      <text class="muted">{{item.qty}}</text>
    </view>
    <view class="row-between goods-sum">
      <text class="muted">订单 {{shipment.orderNo}}</text>
      <text class="price"><text class="price__yen">¥</text>{{shipment.amount}}</text>
    </view>
  </view>

  <view class="surface block">
    <text class="block__h">物流轨迹</text>
    <view class="timeline">
      <view
        wx:for="{{shipment.traces}}"
        wx:key="time"
        class="tl {{item.active ? 'tl--on' : ''}}"
      >
        <view class="tl__dot"></view>
        <view class="tl__body">
          <text class="tl__text">{{item.text}}</text>
          <text class="tl__meta muted">{{item.time}} · {{item.loc}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="footer safe-bottom">
    <button class="btn-ghost footer__ghost" bindtap="goService">联系客服</button>
    <button
      wx:if="{{shipment.canConfirm}}"
      class="btn-primary footer__primary"
      bindtap="goConfirm"
    >确认收货</button>
    <button
      wx:else
      class="btn-primary footer__primary"
      bindtap="goService"
    >遇到问题？</button>
  </view>
</view>

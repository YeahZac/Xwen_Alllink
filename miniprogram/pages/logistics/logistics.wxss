.logistics .section-title--first {
  margin-top: var(--space-md);
}

.ship-card {
  padding: var(--space-md);
  margin-bottom: var(--space-sm);
}

.ship-card__title {
  font-size: var(--font-subtitle);
  font-weight: 800;
  flex: 1;
  margin-right: var(--space-sm);
  color: var(--color-ink);
}

.ship-card__meta {
  display: block;
  margin-top: var(--space-xs);
  font-size: var(--font-caption);
}

.ship-card__eta {
  display: block;
  margin-top: 6rpx;
  font-size: var(--font-caption);
  font-weight: 700;
  color: var(--color-primary-deep);
}

.ship-card__foot {
  margin-top: var(--space-sm);
}

.ship-card__go {
  color: var(--color-primary);
  font-weight: 700;
  font-size: var(--font-caption);
}

.status-banner {
  margin: calc(-1 * var(--space-page)) calc(-1 * var(--space-page)) var(--space-md);
  padding: var(--space-lg) var(--space-page) var(--space-xl);
  background: var(--color-primary);
  color: #fff;
  border-radius: 0 0 var(--radius-xl) var(--radius-xl);
}

.status-banner__t {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 0.04em;
}

.status-banner__s {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-caption);
  opacity: 0.9;
}

.block {
  padding: var(--space-md);
  margin-bottom: var(--space-sm);
}

.block__h {
  display: block;
  font-size: var(--font-body);
  font-weight: 800;
  margin-bottom: var(--space-sm);
  color: var(--color-ink);
}

.block__label {
  font-size: var(--font-caption);
  color: var(--color-text-muted);
}

.block__v {
  font-size: var(--font-body);
  font-weight: 700;
}

.track-row {
  margin-top: var(--space-sm);
  align-items: flex-start;
}

.track-no {
  display: block;
  margin-top: 4rpx;
  font-size: var(--font-subtitle);
  font-weight: 800;
  letter-spacing: 0.02em;
}

.track-acts {
  display: flex;
  gap: var(--space-md);
  flex-shrink: 0;
}

.link {
  color: var(--color-primary);
  font-size: var(--font-caption);
  font-weight: 700;
}

.addr {
  display: flex;
  gap: var(--space-sm);
  margin-bottom: var(--space-md);
}

.addr:last-child {
  margin-bottom: 0;
}

.addr__tag {
  width: 40rpx;
  height: 40rpx;
  border-radius: var(--radius-xs);
  background: var(--color-surface-soft);
  color: var(--color-text-secondary);
  font-size: var(--font-tiny);
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.addr__tag--to {
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
}

.addr__body {
  flex: 1;
  min-width: 0;
}

.addr__t {
  display: block;
  font-size: var(--font-body);
  font-weight: 600;
  line-height: var(--lh-snug);
  margin-bottom: 4rpx;
}

.goods-line {
  padding: 10rpx 0;
  border-bottom: 1rpx solid var(--color-border);
  font-size: var(--font-caption);
}

.goods-sum {
  margin-top: var(--space-sm);
}

.timeline {
  padding-left: 12rpx;
}

.tl {
  position: relative;
  padding-left: 28rpx;
  padding-bottom: var(--space-md);
  border-left: 2rpx solid var(--color-border);
}

.tl:last-child {
  border-left-color: transparent;
  padding-bottom: 0;
}

.tl__dot {
  position: absolute;
  left: -9rpx;
  top: 8rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--color-border-strong);
  box-sizing: border-box;
}

.tl--on .tl__dot {
  background: var(--color-primary);
  box-shadow: 0 0 0 6rpx var(--color-primary-soft);
}

.tl--on .tl__text {
  color: var(--color-primary-deep);
  font-weight: 700;
}

.tl__text {
  display: block;
  font-size: var(--font-caption);
  line-height: var(--lh-body);
  color: var(--color-text);
}

.tl__meta {
  display: block;
  margin-top: 4rpx;
  font-size: var(--font-tiny);
}

.footer {
  position: sticky;
  bottom: 0;
  display: flex;
  gap: var(--space-sm);
  padding: var(--space-sm) 0 calc(var(--space-sm) + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(246, 247, 248, 0) 0%, var(--color-bg) 28%);
}

.footer__ghost {
  flex: 1;
}

.footer__primary {
  flex: 1.4;
}

.empty {
  padding: var(--space-xl) var(--space-md);
  text-align: center;
}

.empty__title {
  display: block;
  font-weight: 700;
  margin-bottom: var(--space-xs);
}

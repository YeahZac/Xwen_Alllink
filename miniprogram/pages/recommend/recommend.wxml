<view class="page recommend">
  <view class="hero">
    <text class="hero__title">邀请好友</text>
    <text class="hero__desc">
      <block wx:if="{{inviteFriendEnabled}}">每成功邀请 1 位好友绑定，您得 {{inviteFriendPoints}} 积分（后台可改）</block>
      <block wx:else>登录即推广员 · 单级推荐 · 规则由平台后台配置</block>
    </text>
    <view class="qr-wrap" wx:if="{{qrcodeUrl}}">
      <image class="qr-img" src="{{qrcodeUrl}}" mode="aspectFit" show-menu-by-longpress="{{true}}" bindtap="onPreviewQr" />
      <text class="qr-tip">专属邀请码 · 长按可识别 / 保存</text>
    </view>
    <view class="qr-wrap qr-wrap--empty" wx:elif="{{qrLoading}}">
      <text class="muted">正在生成专属二维码…</text>
    </view>
    <view class="code-box" bindtap="onCopy">
      <text class="code-box__label">我的邀请码（点按复制）</text>
      <text class="code-box__val">{{code || '—'}}</text>
    </view>
    <view class="hero__stats">
      <view class="hero__stat">
        <text class="hero__n">{{stats.invited}}</text>
        <text class="hero__l">已邀请</text>
      </view>
      <view class="hero__stat">
        <text class="hero__n">{{stats.rewardedPoints}}</text>
        <text class="hero__l">累计奖励</text>
      </view>
    </view>
    <view class="hero__actions">
      <button class="btn-on-primary" open-type="share">分享给好友</button>
      <button class="btn-ghost-light" bindtap="onSaveQr" wx:if="{{qrcodeUrl}}">保存二维码</button>
    </view>
  </view>

  <text class="section-title">奖励规则</text>
  <view class="surface rules">
    <view wx:for="{{rules}}" wx:key="triggerKey" class="rule-row">
      <view class="rule-row__main">
        <text class="rule-row__name">{{item.name}}</text>
        <text class="muted">{{item.remark}}</text>
      </view>
      <text class="rule-row__pts" wx:if="{{item.enabled}}">+{{item.rewardPoints}}</text>
      <text class="muted" wx:else>未启用</text>
    </view>
  </view>

  <block wx:if="{{!bound}}">
    <text class="section-title">绑定推荐人</text>
    <view class="bind surface">
      <input
        class="bind__input"
        placeholder="输入好友邀请码"
        value="{{bindCode}}"
        bindinput="onInput"
      />
      <view class="bind__row">
        <button class="btn-ghost bind__btn" bindtap="onScanBind">扫邀请码</button>
        <button class="btn-ghost bind__btn" bindtap="onBind">确认绑定</button>
      </view>
    </view>
    <text class="muted tip">每人仅可绑定唯一推荐人；扫码或填码成功后按规则给邀请人发积分</text>
  </block>
  <view wx:else class="surface bound">
    <text class="bound__t">已绑定推荐人</text>
    <text class="muted">{{referrerName}} · {{referrerCode}}</text>
  </view>

  <text class="section-title">推荐记录</text>
  <view wx:if="{{!records.length}}" class="empty-state surface">
    <text class="empty-state__title">还没有推荐记录</text>
    <text class="empty-state__desc">分享邀请码或二维码，好友绑定后奖励到账</text>
  </view>
  <view wx:for="{{records}}" wx:key="id" class="rec surface row-between">
    <view class="rec__main">
      <text class="rec__name ellipsis-1">{{item.name}}</text>
      <text class="muted">{{item.triggerName}} · {{item.time}}</text>
    </view>
    <text class="rec__pts">+{{item.reward}}</text>
  </view>
</view>

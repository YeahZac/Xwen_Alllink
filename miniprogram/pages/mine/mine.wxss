/* profile + stats only; list rows use shared m-row */
.profile {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  padding: var(--space-lg) var(--space-page);
  margin-bottom: var(--space-md);
  background: var(--color-ink);
  border-color: transparent;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-sm);
  background: var(--color-primary);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-lead);
  font-weight: 800;
  box-shadow: inset 0 0 0 3rpx rgba(255, 255, 255, 0.28);
  flex-shrink: 0;
}

.avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: 1;
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
}

.avatar-btn::after {
  display: none;
}

.profile__name-input {
  display: block;
  height: 48rpx;
  padding: 0;
  color: #fff;
  font-size: var(--font-title);
  font-weight: 800;
  line-height: var(--lh-snug);
  letter-spacing: 0.02em;
}

.m-row--btn {
  display: flex;
  align-items: center;
  width: 100% !important;
  padding: 24rpx 20rpx;
  margin: 0 !important;
  background: var(--color-surface);
  text-align: left;
  line-height: inherit;
  font-size: inherit;
  border-radius: var(--radius-lg);
}

.m-row--btn::after {
  display: none;
}

.avatar--image {
  display: block;
  background: var(--color-surface-soft);
}

.profile__info {
  flex: 1;
  min-width: 0;
}

.profile__name {
  display: block;
  font-size: var(--font-title);
  font-weight: 800;
  margin-bottom: var(--space-2);
  line-height: var(--lh-snug);
  color: #fff;
  letter-spacing: 0.02em;
}

.profile__role {
  display: block;
  font-size: var(--font-caption);
  color: rgba(255, 255, 255, 0.7);
  letter-spacing: var(--tracking-label);
}

.profile__hint {
  display: block;
  margin-top: 4rpx;
  font-size: var(--font-tiny);
  color: rgba(255, 255, 255, 0.42);
}

.stats {
  display: flex;
  padding: var(--space-2) 0;
  margin-bottom: var(--space-md);
}

.stat {
  flex: 1;
  text-align: center;
  padding: var(--space-md) var(--space-xs);
  border-right: 1rpx solid var(--color-border);
  min-width: 0;
}

.stat:last-child {
  border-right: none;
}

.stat:active {
  background: var(--color-surface-soft);
}

.stat__n {
  display: block;
  font-size: var(--font-lead);
  font-weight: 800;
  color: var(--color-ink);
  margin-bottom: var(--space-2);
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stat__l {
  font-size: var(--font-tiny);
  font-weight: 700;
  letter-spacing: var(--tracking-label);
  color: var(--color-text-muted);
}

.mine picker {
  display: block;
  width: 100%;
}

.m-row--phone {
  position: relative;
}

.m-row__hit {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  width: 100% !important;
  height: 100% !important;
  margin: 0 !important;
  padding: 0 !important;
  opacity: 0;
}

.m-row__hit::after {
  display: none;
}

.mine .profile-card {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  padding: var(--space-lg);
  margin-bottom: var(--space-md);
  background: var(--color-surface);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-soft);
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-lead);
  font-weight: 800;
  flex-shrink: 0;
}

.avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: 1;
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
}

.avatar-btn::after {
  display: none;
}

.avatar--image {
  display: block;
  background: var(--color-surface-soft);
}

.profile__info {
  flex: 1;
  min-width: 0;
}

.profile__name,
.profile__name-input {
  display: block;
  height: 48rpx;
  padding: 0;
  color: var(--color-ink);
  font-size: var(--font-title);
  font-weight: 800;
  line-height: var(--lh-snug);
}

.profile__role {
  display: block;
  margin-top: 4rpx;
  font-size: var(--font-caption);
  color: var(--color-text-muted);
}

.profile__hint {
  display: block;
  margin-top: 4rpx;
  font-size: var(--font-tiny);
  color: var(--color-text-muted);
}

.stats-card {
  display: flex;
  margin: var(--space-md) 0;
  background: var(--color-surface);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-soft);
  overflow: hidden;
}

.stat {
  flex: 1;
  text-align: center;
  padding: var(--space-lg) var(--space-xs);
  border-right: 1rpx solid var(--color-border);
  min-width: 0;
}

.stat:last-child {
  border-right: none;
}

.stat:active {
  background: var(--color-surface-soft);
}

.stat__n {
  display: block;
  font-size: var(--font-lead);
  font-weight: 800;
  color: var(--color-primary);
  margin-bottom: var(--space-2);
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}

.stat__l {
  font-size: var(--font-tiny);
  font-weight: 700;
  letter-spacing: var(--tracking-label);
  color: var(--color-text-muted);
}

.mine picker {
  display: block;
  width: 100%;
}

.m-row--phone {
  position: relative;
}

.m-row__hit {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  width: 100% !important;
  height: 100% !important;
  margin: 0 !important;
  padding: 0 !important;
  opacity: 0;
}

.m-row__hit::after {
  display: none;
}

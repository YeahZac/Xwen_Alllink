.mine.page--flush {
  padding: 0;
  padding-bottom: calc(var(--space-md) + env(safe-area-inset-bottom));
  background: var(--color-bg);
}

.mine-shell {
  padding: var(--space-md) var(--space-page) var(--space-md);
}

.mine .profile-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 0;
  padding: var(--space-lg);
  margin-bottom: var(--space-md);
  background: var(--color-surface);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-soft);
}

.avatar-wrap {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  border-radius: 50%;
  overflow: hidden;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-lead);
  font-weight: 800;
  flex-shrink: 0;
}

/* 透明点击层：避免 button 默认宽度把昵称顶开 */
.avatar-hit {
  position: absolute !important;
  left: 0 !important;
  top: 0 !important;
  width: 96rpx !important;
  height: 96rpx !important;
  min-width: 0 !important;
  min-height: 0 !important;
  max-width: 96rpx !important;
  padding: 0 !important;
  margin: 0 !important;
  border: none !important;
  background: transparent !important;
  opacity: 0;
}

.avatar-hit::after {
  display: none;
}

.avatar--image {
  display: block;
  width: 96rpx;
  height: 96rpx;
  background: var(--color-surface-soft);
}

.profile__info {
  flex: 1;
  min-width: 0;
  /* 微信 nickname input 自带约 8~10px 左内边距，外距用 16px 使文字视觉距头像约 25px */
  margin-left: 16px;
}

.profile__name,
.profile__name-input {
  display: block;
  width: 100%;
  height: 48rpx;
  padding: 0 !important;
  margin: 0 !important;
  color: var(--color-ink);
  font-size: var(--font-title);
  font-weight: 800;
  line-height: var(--lh-snug);
  box-sizing: border-box;
  text-indent: 0 !important;
}

.profile__role {
  display: block;
  margin-top: 4rpx;
  font-size: var(--font-caption);
  color: var(--color-text-muted);
}

.stats-card {
  display: flex;
  margin: var(--space-md) 0;
  background: var(--color-surface);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-soft);
  overflow: hidden;
}

.stat {
  flex: 1;
  text-align: center;
  padding: var(--space-lg) var(--space-xs);
  border-right: 1rpx solid var(--color-border);
  min-width: 0;
}

.stat:last-child {
  border-right: none;
}

.stat:active {
  background: var(--color-surface-soft);
}

.stat__n {
  display: block;
  font-size: var(--font-lead);
  font-weight: 800;
  color: var(--color-primary);
  margin-bottom: var(--space-2);
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}

.stat__l {
  font-size: var(--font-tiny);
  font-weight: 700;
  letter-spacing: var(--tracking-label);
  color: var(--color-text-muted);
}

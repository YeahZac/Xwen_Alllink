<view class="page mine page--flush">
  <page-nav title="我的" tone="solid" />

  <view class="mine-shell">
    <view wx:if="{{!loggedIn}}" class="profile-card" bindtap="goLogin">
      <image class="avatar avatar--image" src="/assets/brand/logo.png" mode="aspectFill" />
      <view class="profile__info">
        <text class="profile__name">点击登录</text>
        <text class="profile__role">{{slogan}}</text>
      </view>
      <text class="m-row__arrow">›</text>
    </view>
    <view wx:else class="profile-card">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image
          class="avatar avatar--image"
          src="{{coverUrl || '/assets/brand/logo.png'}}"
          mode="aspectFill"
        />
      </button>
      <view class="profile__info">
        <input
          class="profile__name-input"
          type="nickname"
          placeholder="填写昵称"
          value="{{name}}"
          bindblur="onNicknameBlur"
        />
        <text class="profile__role ellipsis-1">{{slogan}}</text>
      </view>
    </view>

    <ad-banner role="consumer" page-key="mine" height="220" force="{{true}}" />

    <view class="stats-card">
      <view class="stat" bindtap="goPoints">
        <text class="stat__n">{{points}}</text>
        <text class="stat__l">积分</text>
      </view>
      <view class="stat" bindtap="goOrders">
        <text class="stat__n">{{orderCount}}</text>
        <text class="stat__l">订单</text>
      </view>
      <view class="stat" bindtap="goRecommend">
        <text class="stat__n">荐</text>
        <text class="stat__l">推荐</text>
      </view>
    </view>

    <view class="m-list">
      <view wx:if="{{loggedIn}}" class="m-row" bindtap="goIdentity">
        <view class="m-row__main">
          <text class="m-row__title">切换身份</text>
          <text class="m-row__sub">消费者 / 商家 / 合伙人 / 创始人</text>
        </view>
        <text class="m-row__arrow">›</text>
      </view>
      <view class="m-row" bindtap="goOrders">
        <view class="m-row__main">
          <text class="m-row__title">我的订单</text>
        </view>
        <text class="m-row__arrow">›</text>
      </view>
      <view class="m-row" bindtap="goRecommend">
        <view class="m-row__main">
          <text class="m-row__title">推荐有奖</text>
        </view>
        <text class="m-row__arrow">›</text>
      </view>
      <view class="m-row" bindtap="goSupplyNeed">
        <view class="m-row__main">
          <text class="m-row__title">原材料供应需求</text>
        </view>
        <text class="m-row__arrow">›</text>
      </view>
      <view class="m-row" bindtap="onComplaint">
        <view class="m-row__main">
          <text class="m-row__title">投诉与反馈</text>
        </view>
        <text class="m-row__arrow">›</text>
      </view>
      <view wx:if="{{loggedIn}}" class="m-row" bindtap="onLogout">
        <view class="m-row__main">
          <text class="m-row__title m-row__title--muted">退出登录</text>
        </view>
        <text class="m-row__arrow">›</text>
      </view>
    </view>
  </view>
</view>

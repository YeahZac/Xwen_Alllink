<view class="page mine">
  <view wx:if="{{!loggedIn}}" class="guest-card surface" bindtap="goLogin">
    <view class="avatar">万</view>
    <view class="profile__info">
      <text class="profile__name-input">点击登录</text>
      <text class="profile__hint">登录后查看订单、积分与资料；也可先回首页逛逛</text>
    </view>
    <text class="m-row__arrow">›</text>
  </view>
  <view wx:else class="profile surface">
    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image wx:if="{{coverUrl}}" class="avatar avatar--image" src="{{coverUrl}}" mode="aspectFill" />
      <view wx:else class="avatar">万</view>
    </button>
    <view class="profile__info">
      <input
        class="profile__name-input"
        type="nickname"
        placeholder="填写昵称"
        value="{{name}}"
        bindblur="onNicknameBlur"
      />
      <text class="profile__role ellipsis-1">{{roleLabel}}{{phone ? ' · ' + phone : ' · 未绑定手机'}}{{genderText ? ' · ' + genderText : ''}}</text>
      <text class="profile__hint">点头像、昵称、性别即可修改</text>
    </view>
  </view>

  <view class="stats surface">
    <view class="stat" bindtap="goPoints">
      <text class="stat__n">{{points}}</text>
      <text class="stat__l">积分</text>
    </view>
    <view class="stat" bindtap="goOrders">
      <text class="stat__n">{{orderCount}}</text>
      <text class="stat__l">订单</text>
    </view>
    <view class="stat" bindtap="goRecommend">
      <text class="stat__n">荐</text>
      <text class="stat__l">推荐</text>
    </view>
  </view>

  <ad-banner role="consumer" height="200" />

  <view class="m-list">
    <picker mode="selector" range="{{genderOptions}}" value="{{gender}}" bindchange="onGenderChange">
      <view class="m-row">
        <view class="m-row__seal m-row__seal--soft">性</view>
        <view class="m-row__main">
          <text class="m-row__title">性别</text>
          <text class="m-row__sub">{{genderText || '不展示，可随时修改'}}</text>
        </view>
        <text class="m-row__arrow">›</text>
      </view>
    </picker>
    <view class="m-row m-row--phone">
      <view class="m-row__seal m-row__seal--red">机</view>
      <view class="m-row__main">
        <text class="m-row__title">{{phone ? '更换手机号' : '授权手机号'}}</text>
        <text class="m-row__sub">{{phone ? phone : '用于订单通知与账号保护'}}</text>
      </view>
      <text class="m-row__arrow">›</text>
      <button
        class="m-row__hit"
        open-type="getPhoneNumber"
        bindgetphonenumber="onGetPhone"
        hover-class="none"
      ></button>
    </view>
    <view class="m-row" bindtap="goOrders">
      <view class="m-row__seal m-row__seal--red">单</view>
      <view class="m-row__main">
        <text class="m-row__title">我的订单</text>
      </view>
      <text class="m-row__arrow">›</text>
    </view>
    <view class="m-row" bindtap="goRecommend">
      <view class="m-row__seal m-row__seal--gold">荐</view>
      <view class="m-row__main">
        <text class="m-row__title">推荐有奖</text>
      </view>
      <text class="m-row__arrow">›</text>
    </view>
    <view class="m-row" bindtap="goApply">
      <view class="m-row__seal m-row__seal--red">入</view>
      <view class="m-row__main">
        <text class="m-row__title">申请入驻开店</text>
      </view>
      <text class="m-row__arrow">›</text>
    </view>
    <view class="m-row" bindtap="goSupplyNeed">
      <view class="m-row__seal m-row__seal--teal">供</view>
      <view class="m-row__main">
        <text class="m-row__title">原材料供应需求</text>
      </view>
      <text class="m-row__arrow">›</text>
    </view>
    <view class="m-row" bindtap="openLegalDoc" data-key="user">
      <view class="m-row__seal m-row__seal--soft">用</view>
      <view class="m-row__main">
        <text class="m-row__title">用户服务协议</text>
        <text class="m-row__sub">万业互联云平台用户服务协议</text>
      </view>
      <text class="m-row__arrow">›</text>
    </view>
    <view class="m-row" bindtap="openLegalDoc" data-key="merchant">
      <view class="m-row__seal m-row__seal--soft">入</view>
      <view class="m-row__main">
        <text class="m-row__title">商户入驻平台协议</text>
        <text class="m-row__sub">万业互联云商户入驻服务协议</text>
      </view>
      <text class="m-row__arrow">›</text>
    </view>
    <view class="m-row" bindtap="openLegalDoc" data-key="dispute">
      <view class="m-row__seal m-row__seal--soft">权</view>
      <view class="m-row__main">
        <text class="m-row__title">消费者权益保障措施说明</text>
        <text class="m-row__sub">交易纠纷处理机制说明</text>
      </view>
      <text class="m-row__arrow">›</text>
    </view>
    <view class="m-row" bindtap="onComplaint">
      <view class="m-row__seal m-row__seal--soft">诉</view>
      <view class="m-row__main">
        <text class="m-row__title">投诉与反馈</text>
      </view>
      <text class="m-row__arrow">›</text>
    </view>
    <view wx:if="{{loggedIn}}" class="m-row" bindtap="onLogout">
      <view class="m-row__seal m-row__seal--muted">出</view>
      <view class="m-row__main">
        <text class="m-row__title m-row__title--muted">退出登录</text>
      </view>
      <text class="m-row__arrow">›</text>
    </view>
  </view>
</view>

.detail {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.cover {
  width: 100%;
  height: 420rpx;
  background: var(--color-surface-soft);
}

.cover__img {
  width: 100%;
  height: 100%;
  display: block;
}

.info {
  margin: calc(-1 * var(--space-lg)) var(--space-page) var(--space-sm);
  padding: var(--space-md);
  position: relative;
  z-index: 1;
  border-radius: var(--radius-lg);
}

.info__name {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: var(--color-ink);
  line-height: 1.25;
}

.info__stall {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-caption);
}

.info__desc {
  display: block;
  margin-top: var(--space-sm);
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
  line-height: var(--lh-body);
}

.info__price-row {
  display: flex;
  align-items: baseline;
  gap: var(--space-sm);
  margin-top: var(--space-md);
}

.info__pts {
  font-size: var(--font-caption);
  font-weight: 700;
  color: var(--color-accent-deep);
}

.info__spec {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-caption);
}

.info .chip {
  margin-top: var(--space-sm);
}

.opts {
  margin: 0 var(--space-page) var(--space-sm);
  padding: var(--space-md);
}

.opts__title {
  display: block;
  font-size: var(--font-subtitle);
  font-weight: 800;
  margin-bottom: var(--space-md);
}

.group {
  margin-bottom: var(--space-lg);
}

.group:last-child {
  margin-bottom: 0;
}

.group__name {
  display: block;
  font-size: var(--font-body);
  font-weight: 700;
  margin-bottom: var(--space-sm);
}

.group__opts {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.opt {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 14rpx 22rpx;
  border-radius: var(--radius-pill);
  background: var(--color-surface-soft);
  border: 2rpx solid transparent;
  font-size: var(--font-caption);
  color: var(--color-text);
}

.opt--on {
  background: var(--color-primary-soft);
  border-color: var(--color-primary);
  color: var(--color-primary-deep);
  font-weight: 700;
}

.opt__n {
  font-weight: inherit;
}

.opt__d {
  font-size: var(--font-tiny);
  color: var(--color-primary);
  font-weight: 700;
}

.qty-card {
  margin: 0 var(--space-page) var(--space-md);
  padding: var(--space-md);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.qty-card__l {
  font-size: var(--font-body);
  font-weight: 700;
}

.qty {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.qty__btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--color-surface-soft);
  color: var(--color-ink);
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.qty__btn--plus {
  background: var(--color-primary);
  color: #fff;
}

.qty__n {
  min-width: 48rpx;
  text-align: center;
  font-size: var(--font-subtitle);
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: var(--space-md);
  padding: var(--space-sm) var(--space-page) calc(var(--space-sm) + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -8rpx 24rpx rgba(26, 26, 26, 0.06);
  z-index: 20;
}

.footer__sum {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.footer__btn {
  width: 280rpx;
  flex-shrink: 0;
}

.empty-state {
  padding: 120rpx var(--space-page);
  text-align: center;
}

.empty-state__title {
  display: block;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.empty-state__desc {
  font-size: var(--font-caption);
  color: var(--color-text-muted);
}

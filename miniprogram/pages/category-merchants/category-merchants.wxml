<view class="page cat-merchants">
  <view class="head surface">
    <text class="head__title">{{categoryName || '关联商家'}}</text>
    <text class="head__sub">{{roleLabel ? roleLabel + ' · ' : ''}}已签约可收款商家</text>
  </view>

  <view wx:if="{{loading}}" class="empty-state">
    <text class="empty-state__title">正在加载商家</text>
  </view>

  <view wx:elif="{{!stores.length}}" class="empty-state surface">
    <text class="empty-state__title">暂无关联商家</text>
    <text class="empty-state__desc">该类目下还没有完成收款签约的门店</text>
  </view>

  <view wx:else class="store-grid">
    <view
      wx:for="{{stores}}"
      wx:key="id"
      class="store-tile"
      bindtap="openStore"
      data-id="{{item.id}}"
      data-role="{{item.role}}"
    >
      <view class="store-tile__cover">
        <image wx:if="{{item.coverImage}}" class="cover-img" src="{{item.coverImage}}" mode="aspectFill" />
        <view wx:else class="cover-fallback">{{item.initial}}</view>
      </view>
      <view class="store-tile__body">
        <text class="store-tile__name ellipsis-1">{{item.name}}</text>
        <text class="store-tile__meta ellipsis-1">{{item.metaText || '附近门店'}}</text>
        <text class="store-tile__addr ellipsis-1">{{item.address || item.city || '附近'}}</text>
      </view>
    </view>
  </view>
</view>

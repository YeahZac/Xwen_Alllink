.cat-merchants {
  padding: var(--space-page);
  padding-bottom: calc(var(--space-md) + env(safe-area-inset-bottom));
}

.head {
  padding: var(--space-md);
  margin-bottom: var(--space-md);
  border-radius: var(--radius-xl);
}

.head__title {
  display: block;
  font-size: var(--font-title);
  font-weight: 700;
  color: var(--color-text);
}

.head__sub {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-caption);
  color: var(--color-text-muted);
}

.goods-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}

.goods-row {
  display: flex;
  gap: var(--space-md);
  padding: var(--space-md);
  border-radius: var(--radius-xl);
  overflow: hidden;
}

.goods-row__cover {
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
  border-radius: var(--radius-lg);
  overflow: hidden;
  background: var(--color-surface-soft);
}

.goods-row__cover .cover-img {
  width: 100%;
  height: 100%;
  display: block;
}

.cover-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 700;
  color: var(--color-primary);
  background: linear-gradient(145deg, #fff5eb, #ffe4cc);
}

.goods-row__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.goods-row__name {
  display: block;
  font-size: var(--font-body);
  font-weight: 700;
  color: var(--color-text);
}

.goods-row__price {
  display: block;
  margin-top: 8rpx;
  font-size: var(--font-caption);
  font-weight: 600;
  color: var(--color-primary);
}

.goods-row__meta {
  display: block;
  margin-top: 6rpx;
  font-size: var(--font-tiny);
  color: var(--color-text-muted);
}

.login-page {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 0;
}

.login-head {
  background: #0E1014;
  padding: 12rpx 24rpx 72rpx;
  position: relative;
  overflow: hidden;
}

.login-head::after {
  content: "";
  position: absolute;
  right: -48rpx;
  top: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border: 12rpx solid rgba(196, 30, 58, 0.38);
  border-radius: var(--radius-md);
  transform: rotate(18deg);
  pointer-events: none;
}

.login-head__row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.login-head__brand {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  min-width: 0;
}

.login-head__seal {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 36rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: inset 0 0 0 3rpx rgba(255, 255, 255, 0.32);
}

.login-head__copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.login-head__name {
  font-size: 36rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 0.04em;
  line-height: 1.15;
}

.login-head__line {
  font-size: var(--font-caption);
  color: rgba(255, 255, 255, 0.62);
  letter-spacing: 0.08em;
  font-weight: 600;
}

.login-close {
  flex-shrink: 0;
  min-width: 88rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: right;
  color: rgba(255, 255, 255, 0.82);
  font-size: var(--font-caption);
  font-weight: 700;
}

.login-sheet {
  margin-top: -28rpx;
  background: var(--color-surface);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  padding: 48rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  min-height: 72vh;
}

.login-title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: var(--color-ink);
  letter-spacing: 0.02em;
  line-height: 1.25;
}

.login-lead {
  display: block;
  margin: 12rpx 0 32rpx;
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
  line-height: var(--lh-body);
}

.login-pending {
  margin: -12rpx 0 24rpx;
  padding: 16rpx 20rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
  border-radius: var(--radius-md);
  font-size: var(--font-caption);
  line-height: var(--lh-snug);
  font-weight: 600;
}

.agree-wrap {
  position: relative;
  margin: 8rpx 0 28rpx;
}

.agree-tip {
  position: absolute;
  left: 0;
  bottom: 100%;
  margin-bottom: 10rpx;
  padding: 8rpx 16rpx;
  background: var(--color-ink);
  color: #fff;
  font-size: var(--font-small);
  font-weight: 700;
  border-radius: var(--radius-sm);
  line-height: 1.4;
}

.agree-tip::after {
  content: "";
  position: absolute;
  left: 18rpx;
  top: 100%;
  border: 10rpx solid transparent;
  border-top-color: var(--color-ink);
}

.agree-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.agree-box {
  width: 36rpx;
  height: 36rpx;
  margin-top: 4rpx;
  border-radius: 8rpx;
  border: 3rpx solid var(--color-border-strong);
  background: var(--color-surface);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.agree-box--on {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.agree-box__tick {
  width: 16rpx;
  height: 10rpx;
  border-left: 4rpx solid #fff;
  border-bottom: 4rpx solid #fff;
  transform: rotate(-45deg) translate(1rpx, -2rpx);
}

.agree-copy {
  flex: 1;
  min-width: 0;
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
  line-height: var(--lh-body);
}

.agree-link {
  color: var(--color-primary-deep);
  font-weight: 700;
}

.login-btn {
  width: 100% !important;
  margin-bottom: var(--space-md);
}

.login-skip {
  width: 100% !important;
  height: 72rpx;
  line-height: 72rpx;
  margin: 0 0 var(--space-md);
  padding: 0;
  background: transparent;
  color: var(--color-text-secondary);
  font-size: var(--font-caption);
  font-weight: 700;
  letter-spacing: 0.04em;
  border: none;
}

.login-skip::after {
  display: none;
}

.login-extra {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin: 8rpx 0 40rpx;
}

.login-extra__a {
  font-size: var(--font-caption);
  font-weight: 700;
  color: var(--color-text-secondary);
}

.login-extra__a:active {
  color: var(--color-primary);
}

.login-extra__dot {
  color: var(--color-text-muted);
}

.login-test__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: var(--space-sm);
}

.login-test__title {
  font-size: var(--font-caption);
  font-weight: 700;
  color: var(--color-text-muted);
}

.login-test__toggle {
  font-size: var(--font-caption);
  font-weight: 700;
  color: var(--color-primary);
}

.id-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: var(--space-md);
}

.id-tile {
  width: calc(50% - 8rpx);
  padding: 28rpx 24rpx;
  background: var(--color-surface-soft);
  border-radius: var(--radius-md);
}

.id-tile:active {
  background: var(--color-primary-soft);
}

.id-tile__code {
  display: block;
  font-size: var(--font-lead);
  font-weight: 800;
  color: var(--color-ink);
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.04em;
}

.id-tile__role {
  display: block;
  margin-top: 6rpx;
  font-size: var(--font-small);
  color: var(--color-text-secondary);
}

.login-code {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  margin-bottom: 8rpx;
  background: var(--color-surface-soft);
  border-radius: var(--radius-md);
  border: none;
}

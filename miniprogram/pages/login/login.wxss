.auth-page {
  min-height: 100vh;
  background:
    radial-gradient(120% 80% at 10% -10%, rgba(255, 77, 79, 0.14), transparent 55%),
    radial-gradient(90% 60% at 100% 0%, rgba(15, 23, 42, 0.06), transparent 50%),
    #f5f6f8;
  box-sizing: border-box;
}

.auth-safe {
  min-height: 100vh;
  padding: 0 40rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.auth-top {
  min-height: 56rpx;
  display: flex;
  justify-content: flex-end;
  margin-bottom: 24rpx;
}

.auth-close {
  padding: 8rpx 4rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #646a73;
}

.auth-brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 48rpx 0 56rpx;
}

.auth-mark {
  width: 112rpx;
  height: 112rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #ff6b6d 0%, #ff4d4f 55%, #e03b3d 100%);
  color: #fff;
  font-size: 52rpx;
  font-weight: 800;
  letter-spacing: 0.04em;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 40rpx rgba(255, 77, 79, 0.28);
  margin-bottom: 28rpx;
}

.auth-name {
  font-size: 44rpx;
  font-weight: 800;
  color: #1f2329;
  letter-spacing: 0.06em;
  line-height: 1.2;
}

.auth-tag {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8f959e;
  letter-spacing: 0.12em;
  font-weight: 500;
}

.auth-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 48rpx 40rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(15, 23, 42, 0.06);
}

.auth-hello {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #1f2329;
  letter-spacing: 0.02em;
}

.auth-desc {
  display: block;
  margin-top: 12rpx;
  margin-bottom: 36rpx;
  font-size: 26rpx;
  color: #8f959e;
  line-height: 1.55;
}

.auth-pending {
  margin: -12rpx 0 28rpx;
  padding: 20rpx 24rpx;
  background: #fff1f0;
  color: #cf1322;
  border-radius: 16rpx;
  font-size: 24rpx;
  line-height: 1.5;
  font-weight: 600;
}

.auth-agree {
  position: relative;
  margin-bottom: 32rpx;
}

.auth-tip {
  position: absolute;
  left: 0;
  bottom: calc(100% + 12rpx);
  padding: 10rpx 18rpx;
  background: #1f2329;
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 10rpx;
}

.auth-tip::after {
  content: "";
  position: absolute;
  left: 20rpx;
  top: 100%;
  border: 10rpx solid transparent;
  border-top-color: #1f2329;
}

.auth-agree__row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.auth-check {
  width: 36rpx;
  height: 36rpx;
  margin-top: 4rpx;
  border-radius: 50%;
  border: 3rpx solid #d0d3d9;
  background: #fff;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.auth-check--on {
  background: #ff4d4f;
  border-color: #ff4d4f;
}

.auth-check__tick {
  width: 14rpx;
  height: 8rpx;
  border-left: 3rpx solid #fff;
  border-bottom: 3rpx solid #fff;
  transform: rotate(-45deg) translate(1rpx, -1rpx);
}

.auth-agree__text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #8f959e;
  line-height: 1.65;
}

.auth-link {
  color: #ff4d4f;
  font-weight: 650;
}

.auth-btn {
  width: 100% !important;
  height: 96rpx !important;
  line-height: 96rpx !important;
  border-radius: 48rpx !important;
  font-size: 32rpx !important;
  font-weight: 700 !important;
  margin: 0 0 20rpx !important;
  padding: 0 !important;
  border: none !important;
}

.auth-btn::after {
  display: none;
}

.auth-btn--primary {
  background: #ff4d4f !important;
  color: #fff !important;
  box-shadow: 0 12rpx 28rpx rgba(255, 77, 79, 0.28);
}

.auth-btn--primary[disabled] {
  opacity: 0.55;
}

.auth-btn--ghost {
  background: transparent !important;
  color: #8f959e !important;
  box-shadow: none !important;
  height: 72rpx !important;
  line-height: 72rpx !important;
  font-size: 28rpx !important;
  margin-bottom: 0 !important;
}

.auth-foot {
  margin-top: auto;
  padding-top: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.auth-foot__a {
  font-size: 26rpx;
  font-weight: 600;
  color: #646a73;
}

.auth-foot__a:active {
  color: #ff4d4f;
}

.auth-foot__dot {
  color: #c0c4cc;
}

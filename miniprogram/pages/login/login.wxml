<view class="auth-page">
  <view class="auth-safe" style="padding-top: {{headerTop}}px;">
    <view class="auth-top">
      <view wx:if="{{canSkip}}" class="auth-close" bindtap="skipLogin">关闭</view>
    </view>

    <view class="auth-brand">
      <view class="auth-mark">万</view>
      <text class="auth-name">万业互联云</text>
      <text class="auth-tag">附近好店 · 积分可兑</text>
    </view>

    <view class="auth-card">
      <text class="auth-hello">欢迎回来</text>
      <text class="auth-desc">使用手机号一键登录。头像、昵称可在「我的」完善。</text>

      <view class="auth-pending" wx:if="{{pendingHint}}">{{pendingHint}}</view>
      <button wx:if="{{canReturnPay}}" class="auth-btn auth-btn--primary" bindtap="returnPay">返回支付</button>

      <view class="auth-agree">
        <view class="auth-tip" wx:if="{{showAgreeTip}}">请先勾选并阅读协议</view>
        <view class="auth-agree__row" bindtap="toggleAgree">
          <view class="auth-check {{agreed ? 'auth-check--on' : ''}}">
            <view wx:if="{{agreed}}" class="auth-check__tick"></view>
          </view>
          <view class="auth-agree__text">
            <text>我已阅读并同意</text>
            <text class="auth-link" catchtap="openLegal" data-key="user">《用户服务协议》</text>
            <text>、</text>
            <text class="auth-link" catchtap="openLegal" data-key="dispute">《消费者权益保障措施说明》</text>
            <text>与</text>
            <text class="auth-link" catchtap="openLegal" data-key="privacy">《平台隐私政策》</text>
          </view>
        </view>
      </view>

      <button
        wx:if="{{agreed}}"
        class="auth-btn auth-btn--primary"
        open-type="getPhoneNumber"
        bindgetphonenumber="onPhoneLogin"
        loading="{{loading}}"
        disabled="{{loading}}"
      >手机号一键登录</button>
      <button
        wx:else
        class="auth-btn auth-btn--primary"
        bindtap="onNeedAgree"
        disabled="{{loading}}"
      >手机号一键登录</button>

      <button wx:if="{{canSkip}}" class="auth-btn auth-btn--ghost" bindtap="skipLogin" disabled="{{loading}}">暂不登录</button>
    </view>

    <view class="auth-foot">
      <text class="auth-foot__a" bindtap="goApply">商户入驻</text>
      <text class="auth-foot__dot">·</text>
      <text class="auth-foot__a" bindtap="queryApply">查询进度</text>
    </view>
  </view>
</view>

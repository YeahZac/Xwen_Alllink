<view class="role-tabbar">
  <view
    wx:for="{{tabs}}"
    wx:key="id"
    class="role-tab {{active === item.id ? 'role-tab--on' : ''}}"
    data-id="{{item.id}}"
    data-url="{{item.url}}"
    bindtap="onTap"
  >
    <image
      class="role-tab__icon"
      src="{{active === item.id ? item.iconOn : item.icon}}"
      mode="aspectFit"
    />
    <text class="role-tab__t">{{item.title}}</text>
  </view>
</view>

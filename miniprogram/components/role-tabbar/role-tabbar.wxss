.role-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: stretch;
  min-height: 100rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  border-top: 1rpx solid #eee;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.role-tab {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 4rpx;
}

.role-tab__t {
  font-size: 22rpx;
  color: #8f959e;
  font-weight: 600;
  text-align: center;
  line-height: 1.2;
}

.role-tab--on .role-tab__t {
  color: #ff4d4f;
  font-weight: 800;
}

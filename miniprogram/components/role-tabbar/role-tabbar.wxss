/* 多身份底栏 · 对齐 C 端 tabBar 规格 */
.role-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: flex-start;
  justify-content: space-around;
  height: calc(112rpx + env(safe-area-inset-bottom));
  padding: 12rpx 0 env(safe-area-inset-bottom);
  box-sizing: border-box;
  background: #ffffff;
  border-top: 1rpx solid #ede8e3;
  box-shadow: 0 -4rpx 20rpx rgba(31, 35, 41, 0.04);
}

.role-tab {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 6rpx;
  padding: 0 6rpx;
  box-sizing: border-box;
}

.role-tab__icon {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  display: block;
}

.role-tab__t {
  width: 100%;
  max-width: 100%;
  padding: 0 2rpx;
  box-sizing: border-box;
  font-size: 22rpx;
  line-height: 1.25;
  color: #8f959e;
  font-weight: 600;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.role-tab--on .role-tab__t {
  color: #ff4d4f;
  font-weight: 700;
}

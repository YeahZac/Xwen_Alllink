<view class="ad-banner page-block" wx:if="{{list.length || force}}">
  <swiper
    class="ad-banner__swiper"
    style="height: {{height}}rpx"
    indicator-dots="{{list.length > 1}}"
    indicator-color="rgba(255,255,255,0.45)"
    indicator-active-color="#ffffff"
    autoplay="{{list.length > 1}}"
    circular="{{list.length > 1}}"
    interval="4500"
    bindchange="onChange"
  >
    <swiper-item wx:for="{{list}}" wx:key="id">
      <view class="ad-banner__slide" bindtap="onTap" data-index="{{index}}">
        <image
          wx:if="{{!item.imgError}}"
          class="ad-banner__img"
          src="{{item.image}}"
          mode="aspectFill"
          binderror="onImgError"
          data-index="{{index}}"
        />
        <view wx:else class="ad-banner__fallback"></view>
        <view class="ad-banner__mask">
          <text class="ad-banner__title ellipsis-1">{{item.title}}</text>
          <text class="ad-banner__sub ellipsis-1">{{item.sub}}</text>
        </view>
      </view>
    </swiper-item>
  </swiper>
</view>

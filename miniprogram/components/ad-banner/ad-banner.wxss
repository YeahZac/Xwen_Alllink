.ad-banner {
  position: relative;
  margin-bottom: var(--space-md);
}

.ad-banner__swiper {
  border-radius: 24rpx;
  overflow: hidden;
  background: #2a1216;
  box-shadow: 0 8rpx 24rpx rgba(31, 35, 41, 0.08);
}

.ad-banner__slide {
  width: 100%;
  height: 100%;
  position: relative;
  overflow: hidden;
}

.ad-banner__img,
.ad-banner__fallback {
  width: 100%;
  height: 100%;
  display: block;
}

.ad-banner__img--ph {
  position: absolute;
  left: 0;
  top: 0;
  filter: blur(6rpx);
  transform: scale(1.06);
}

.ad-banner__fallback {
  background: linear-gradient(120deg, #ff8a5c 0%, #ff4d4f 48%, #c41e3a 100%);
}

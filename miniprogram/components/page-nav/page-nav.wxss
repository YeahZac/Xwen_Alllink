.page-nav {
  position: relative;
  z-index: 20;
  color: #fff;
}

.page-nav--solid {
  background: #ff4d4f;
}

.page-nav--gradient {
  background: transparent;
}

.page-nav--flush {
  background: transparent;
}

.page-nav__bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 16rpx;
  box-sizing: border-box;
}

.page-nav__title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.2;
  letter-spacing: 0.02em;
}

.page-nav__home {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.page-nav__home--spacer {
  visibility: hidden;
  background: transparent;
}

.page-nav__home--active {
  opacity: 0.85;
}

.page-nav__home-ico {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid #fff;
  border-radius: 6rpx 6rpx 4rpx 4rpx;
  position: relative;
  box-sizing: border-box;
}

.page-nav__home-ico::before {
  content: '';
  position: absolute;
  left: 50%;
  top: -10rpx;
  width: 22rpx;
  height: 22rpx;
  border-left: 3rpx solid #fff;
  border-top: 3rpx solid #fff;
  transform: translateX(-50%) rotate(45deg);
  box-sizing: border-box;
}

.page-nav__back-ico {
  width: 18rpx;
  height: 18rpx;
  border-left: 4rpx solid #fff;
  border-bottom: 4rpx solid #fff;
  transform: rotate(45deg);
  margin-left: 6rpx;
}
